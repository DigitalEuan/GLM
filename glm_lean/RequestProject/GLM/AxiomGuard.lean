import Lean

/-!
# Axiom guard: an axiom audit that fails the build

*Created 21 October 2026* (Phase 176), from `source_material/GLM_Pipeline_Kit/GLMKit/AxiomAudit.lean`
of the owner's pipeline kit. The kit's audit is a list of `#print axioms` lines: it prints, and a
reader has to check the output by eye. This file turns the same check into one the build enforces.

* `#guard_axioms n₁ n₂ …` fails to elaborate if any named declaration depends on an axiom
  outside the standard set.
* `#guard_axioms_prefix P` does the same for **every** theorem whose name starts with `P` in
  every imported module whose name starts with `RequestProject` (one shared traversal), and
  reports how many theorems it checked; `#guard_axioms_development` does it for every theorem
  of every imported `RequestProject` module (used by `AxiomAuditAll.lean`).

The standard set is the one the project has always accepted: `propext`, `Classical.choice`,
`Quot.sound`, `Lean.ofReduceBool`, `Lean.trustCompiler`, plus the auxiliary axioms that
`native_decide` / `bv_decide` themselves generate (names containing `._native.native_decide.ax_`
or `._native.bv_decide.ax_`). A hand-written `axiom`, or `sorryAx` (which is what an unfinished proof
leaves behind), makes the command fail.
-/

namespace GLM.AxiomGuard

open Lean Elab Command

/-- The axioms a GLM result is allowed to depend on. -/
def standardAxioms : List Name :=
  [``propext, ``Classical.choice, ``Quot.sound, ``Lean.ofReduceBool, ``Lean.trustCompiler]

/-- `true` for an axiom in the standard set or one generated by `native_decide`/`bv_decide`. -/
def isStandardAxiom (n : Name) : Bool :=
  standardAxioms.contains n ||
    (n.toString.splitOn "._native.native_decide.ax_").length > 1 ||
    (n.toString.splitOn "._native.bv_decide.ax_").length > 1

/-- Collect the axioms used by every constant in `roots`, sharing one visited set. -/
partial def collectMany (env : Environment) (roots : Array Name) : Array Name := Id.run do
  let mut visited : NameSet := {}
  let mut axs : Array Name := #[]
  let mut stack : Array Name := roots
  while !stack.isEmpty do
    let c := stack.back!
    stack := stack.pop
    if visited.contains c then continue
    visited := visited.insert c
    match env.find? c with
    | some (.axiomInfo _) => axs := axs.push c
    | some info =>
        for d in info.type.getUsedConstants do
          unless visited.contains d do stack := stack.push d
        if let some v := info.value? (allowOpaque := true) then
          for d in v.getUsedConstants do
            unless visited.contains d do stack := stack.push d
    | none => pure ()
  return axs

/-- The non-standard axioms used by one declaration. -/
def badAxiomsOf (env : Environment) (n : Name) : Array Name :=
  (collectMany env #[n]).filter (! isStandardAxiom ·)

/-- `#guard_axioms n₁ n₂ …`: fail unless each declaration uses only standard axioms. -/
elab "#guard_axioms " ids:ident+ : command => do
  let env ← getEnv
  let mut bad : Array MessageData := #[]
  for id in ids do
    let n ← liftCoreM <| realizeGlobalConstNoOverloadWithInfo id
    let b := badAxiomsOf env n
    unless b.isEmpty do bad := bad.push m!"{n} uses {b.toList}"
  if bad.isEmpty then
    logInfo m!"axiom guard: {ids.size} declarations, standard axioms only"
  else
    throwError m!"axiom guard failed:\n{MessageData.joinSep bad.toList "\n"}"

/-- Every theorem named `pre…` (any name when `pre` is anonymous) declared in a module whose
name starts with `RequestProject`. -/
def developmentTheorems (env : Environment) (pre : Name) : Array Name := Id.run do
  let mut roots : Array Name := #[]
  for (n, info) in env.constants.toList do
    if let .thmInfo _ := info then
      if pre.isPrefixOf n then
        if let some idx := env.getModuleIdxFor? n then
          let m := env.header.moduleNames[idx.toNat]!
          if (`RequestProject).isPrefixOf m then roots := roots.push n
  return roots

/-- Guard every theorem of `developmentTheorems env pre`, with one shared traversal; on failure
attribute the offending axioms back to (up to 20 of) the theorems that use them. -/
def guardDevelopment (pre : Name) : CommandElabM Unit := do
  let env ← getEnv
  let roots := developmentTheorems env pre
  if roots.isEmpty then throwError m!"axiom guard: no theorems found under {pre}"
  let axs := (collectMany env roots).filter (! isStandardAxiom ·)
  if axs.isEmpty then
    logInfo m!"axiom guard: {roots.size} theorems under {pre}, standard axioms only"
  else
    let offenders := roots.filter fun r => !(badAxiomsOf env r).isEmpty
    throwError m!"axiom guard failed: non-standard axioms {axs.toList} used by \
      {offenders.toList.take 20}"

/-- `#guard_axioms_prefix P`: every theorem named `P…` in a `RequestProject…` module uses only
standard axioms. Fails, naming the offenders, otherwise. -/
elab "#guard_axioms_prefix " p:ident : command => guardDevelopment p.getId

/-- `#guard_axioms_development`: every theorem in every imported `RequestProject…` module uses
only standard axioms. -/
elab "#guard_axioms_development" : command => guardDevelopment .anonymous

end GLM.AxiomGuard
