module

public import Mathlib

/-!
# Derivations and proofs: what the Phase 106 readings rest on

`studies/DERIVATION_STUDY.md` (Phase 106) adds four derivations to the
machine (`glm_universal/reasoning/proof_search.py` and
`glm_universal/reasoning/derivation.py`).  This file proves the facts
their readings rest on.

## 1.  The prover's rules are sound

`Fml` is a propositional formula, `Fml.eval v` its truth value under a
valuation of the atoms, and `G4ip Γ G` the derivability relation generated by
exactly the rules the prover emits and its column-3 script re-checks
(`axiom` (here `ax`), `L-false`, `R->`, `R&`, `R|1`, `R|2`, `L&`, `L|`, `L-false->`,
`L0->`, `L&->`, `L|->`, `L->->`), with the principal formula removed from
the context by `List.erase` as the prover removes it from its multiset.

`g4ip_sound`: whatever `G4ip` derives is true under every valuation that
makes the context true.  So every proof the prover prints, intuitionistic or
from instances of excluded middle, establishes a tautology.

## 2.  Curry's derivation

`curry_derivation`: from `C ↔ (C → F)` alone, `F`.  The proof uses only the
two halves of the biconditional, implication introduction and modus ponens
-- no negation and no classical axiom -- which is the content of the outside
question the `curry_paradox` frame reads.

## 3.  The three shell profiles

`slab_profile`, `cylinder_profile`, `sphere_profile`: the profiles the
two-quadrature operation prints for `d/dx(x^n dy/dx) = 0` with `n = 0, 1, 2`
take the boundary values and satisfy the equation (for the cylinder and the
sphere on `r > 0`).

## 4.  The double pendulum's normal modes

`double_pendulum_modes`: with the linearised mass and stiffness matrices
`M = l [[2, 1], [1, 1]]`, `K = g [[2, 0], [0, 1]]` (the reading's equations
`2 l θ₁'' + l θ₂'' + 2 g θ₁ = 0`, `l θ₁'' + l θ₂'' + g θ₂ = 0`), both
`w² = (2 ± √2) g / l` make `det (K - w² M)` vanish.
-/

@[expose] public section

namespace GLM.Derivations

/-! ## 1.  Soundness of the sequent rules -/

/-- A propositional formula: atoms, falsum, implication, conjunction,
disjunction (negation is `imp A bot`, the biconditional two implications). -/
inductive Fml where
  | atom : ℕ → Fml
  | bot : Fml
  | imp : Fml → Fml → Fml
  | and : Fml → Fml → Fml
  | or : Fml → Fml → Fml
  deriving DecidableEq

/-- The truth value of a formula under a valuation of the atoms. -/
def Fml.eval (v : ℕ → Bool) : Fml → Bool
  | .atom n => v n
  | .bot => false
  | .imp a b => !a.eval v || b.eval v
  | .and a b => a.eval v && b.eval v
  | .or a b => a.eval v || b.eval v

/-- The rules of Dyckhoff's G4ip, as the prover applies them. -/
inductive G4ip : List Fml → Fml → Prop where
  | ax {Γ n} : Fml.atom n ∈ Γ → G4ip Γ (.atom n)
  | lfalse {Γ G} : Fml.bot ∈ Γ → G4ip Γ G
  | rimp {Γ A B} : G4ip (A :: Γ) B → G4ip Γ (.imp A B)
  | rand {Γ A B} : G4ip Γ A → G4ip Γ B → G4ip Γ (.and A B)
  | ror1 {Γ A B} : G4ip Γ A → G4ip Γ (.or A B)
  | ror2 {Γ A B} : G4ip Γ B → G4ip Γ (.or A B)
  | land {Γ A B G} : Fml.and A B ∈ Γ →
      G4ip (A :: B :: Γ.erase (.and A B)) G → G4ip Γ G
  | lor {Γ A B G} : Fml.or A B ∈ Γ →
      G4ip (A :: Γ.erase (.or A B)) G → G4ip (B :: Γ.erase (.or A B)) G →
      G4ip Γ G
  | lfalseimp {Γ B G} : Fml.imp .bot B ∈ Γ →
      G4ip (Γ.erase (.imp .bot B)) G → G4ip Γ G
  | l0imp {Γ n B G} : Fml.imp (.atom n) B ∈ Γ →
      Fml.atom n ∈ Γ.erase (.imp (.atom n) B) →
      G4ip (B :: Γ.erase (.imp (.atom n) B)) G → G4ip Γ G
  | landimp {Γ C D B G} : Fml.imp (.and C D) B ∈ Γ →
      G4ip (.imp C (.imp D B) :: Γ.erase (.imp (.and C D) B)) G → G4ip Γ G
  | lorimp {Γ C D B G} : Fml.imp (.or C D) B ∈ Γ →
      G4ip (.imp C B :: .imp D B :: Γ.erase (.imp (.or C D) B)) G →
      G4ip Γ G
  | limpimp {Γ C D B G} : Fml.imp (.imp C D) B ∈ Γ →
      G4ip (.imp D B :: Γ.erase (.imp (.imp C D) B)) (.imp C D) →
      G4ip (B :: Γ.erase (.imp (.imp C D) B)) G → G4ip Γ G

/-- Every rule of G4ip is sound for every valuation: a derived sequent is a
tautology. -/
theorem g4ip_sound {Γ : List Fml} {G : Fml} (h : G4ip Γ G) (v : ℕ → Bool)
    (hΓ : ∀ g ∈ Γ, g.eval v = true) : G.eval v = true := by
  induction h with
  | ax hm => exact hΓ _ hm
  | lfalse hm => simpa [Fml.eval] using hΓ _ hm
  | @rimp Γ A B _ ih =>
    simp only [Fml.eval, Bool.or_eq_true, Bool.not_eq_true']
    by_cases ha : A.eval v = true
    · right
      exact ih (by
        intro g hg
        rcases List.mem_cons.1 hg with rfl | hg
        · exact ha
        · exact hΓ g hg)
    · left
      simpa using ha
  | rand _ _ ih1 ih2 =>
    simp [Fml.eval, ih1 hΓ, ih2 hΓ]
  | ror1 _ ih => simp [Fml.eval, ih hΓ]
  | ror2 _ ih => simp [Fml.eval, ih hΓ]
  | land hm _ ih =>
    have h0 := hΓ _ hm
    simp only [Fml.eval, Bool.and_eq_true] at h0
    exact ih (by
      intro g hg
      rcases List.mem_cons.1 hg with rfl | hg
      · exact h0.1
      rcases List.mem_cons.1 hg with rfl | hg
      · exact h0.2
      · exact hΓ g (List.mem_of_mem_erase hg))
  | lor hm _ _ ih1 ih2 =>
    have h0 := hΓ _ hm
    simp only [Fml.eval, Bool.or_eq_true] at h0
    rcases h0 with h0 | h0
    · exact ih1 (by
        intro g hg
        rcases List.mem_cons.1 hg with rfl | hg
        · exact h0
        · exact hΓ g (List.mem_of_mem_erase hg))
    · exact ih2 (by
        intro g hg
        rcases List.mem_cons.1 hg with rfl | hg
        · exact h0
        · exact hΓ g (List.mem_of_mem_erase hg))
  | lfalseimp _ _ ih =>
    exact ih (fun g hg => hΓ g (List.mem_of_mem_erase hg))
  | l0imp hm ha _ ih =>
    have h0 := hΓ _ hm
    have h1 := hΓ _ (List.mem_of_mem_erase ha)
    simp only [Fml.eval, Bool.or_eq_true, Bool.not_eq_true'] at h0 h1
    exact ih (by
      intro g hg
      rcases List.mem_cons.1 hg with rfl | hg
      · rcases h0 with h0 | h0
        · simp [h0] at h1
        · exact h0
      · exact hΓ g (List.mem_of_mem_erase hg))
  | landimp hm _ ih =>
    have h0 := hΓ _ hm
    exact ih (by
      intro g hg
      rcases List.mem_cons.1 hg with rfl | hg
      · revert h0
        simp only [Fml.eval]
        cases Fml.eval v _ <;> cases Fml.eval v _ <;> cases Fml.eval v _ <;>
          simp
      · exact hΓ g (List.mem_of_mem_erase hg))
  | lorimp hm _ ih =>
    have h0 := hΓ _ hm
    exact ih (by
      intro g hg
      rcases List.mem_cons.1 hg with rfl | hg
      · revert h0
        simp only [Fml.eval]
        cases Fml.eval v _ <;> cases Fml.eval v _ <;> cases Fml.eval v _ <;>
          simp
      rcases List.mem_cons.1 hg with rfl | hg
      · revert h0
        simp only [Fml.eval]
        cases Fml.eval v _ <;> cases Fml.eval v _ <;> cases Fml.eval v _ <;>
          simp
      · exact hΓ g (List.mem_of_mem_erase hg))
  | @limpimp Γ C D B G hm _ _ ih1 ih2 =>
    have h0 := hΓ _ hm
    have hDB : (Fml.imp D B).eval v = true := by
      revert h0
      simp only [Fml.eval]
      cases Fml.eval v C <;> cases Fml.eval v D <;> cases Fml.eval v B <;>
        simp
    have hCD : (Fml.imp C D).eval v = true := ih1 (by
      intro g hg
      rcases List.mem_cons.1 hg with rfl | hg
      · exact hDB
      · exact hΓ g (List.mem_of_mem_erase hg))
    have hB : B.eval v = true := by
      revert h0 hCD
      simp only [Fml.eval]
      cases Fml.eval v (Fml.imp C D) <;> cases Fml.eval v B <;> simp
    exact ih2 (by
      intro g hg
      rcases List.mem_cons.1 hg with rfl | hg
      · exact hB
      · exact hΓ g (List.mem_of_mem_erase hg))

/-! ## 2.  Curry's derivation -/

/-- From `C ↔ (C → F)` alone, `F`, using only the halves of the
biconditional, implication introduction and modus ponens. -/
theorem curry_derivation (C F : Prop) (h : C ↔ (C → F)) : F :=
  have hCF : C → F := fun hc => (h.mp hc) hc
  hCF (h.mpr hCF)

/-! ## 3.  The shell profiles -/

/-- The slab: `T = T1 + (T2 - T1) x / L` has zero second derivative and the
boundary values `T(0) = T1`, `T(L) = T2`. -/
theorem slab_profile (T1 T2 L : ℝ) (hL : L ≠ 0) :
    let T : ℝ → ℝ := fun x => T1 + (T2 - T1) * x / L
    (∀ x, deriv (fun y => deriv T y) x = 0) ∧ T 0 = T1 ∧ T L = T2 := by
  intro T
  have hd : ∀ y, deriv T y = (T2 - T1) / L := by
    intro y
    have : HasDerivAt T ((T2 - T1) * 1 / L) y := by
      have := ((hasDerivAt_id y).const_mul (T2 - T1)).div_const L
      simpa [T] using this.const_add T1
    simpa using this.deriv
  refine ⟨fun x => ?_, by simp [T], ?_⟩
  · simp [hd]
  · simp only [T]
    field_simp
    ring

/-- The cylinder: `T = T1 + (T2 - T1) (ln r - ln R1)/(ln R2 - ln R1)` has
`d/dr (r dT/dr) = 0` for `r > 0` and the boundary values. -/
theorem cylinder_profile (T1 T2 R1 R2 : ℝ) (hR : Real.log R2 ≠ Real.log R1) :
    let T : ℝ → ℝ := fun r =>
      T1 + (T2 - T1) * (Real.log r - Real.log R1) / (Real.log R2 - Real.log R1)
    (∀ r, 0 < r → deriv (fun y => y * deriv T y) r = 0) ∧
      T R1 = T1 ∧ T R2 = T2 := by
  intro T
  have hne : Real.log R2 - Real.log R1 ≠ 0 := sub_ne_zero.2 hR
  have hd : ∀ y, y ≠ 0 →
      deriv T y = (T2 - T1) * y⁻¹ / (Real.log R2 - Real.log R1) := by
    intro y hy
    have h1 : HasDerivAt (fun r => Real.log r - Real.log R1) y⁻¹ y := by
      simpa using (Real.hasDerivAt_log hy).sub_const (Real.log R1)
    have h2 := ((h1.const_mul (T2 - T1)).div_const
      (Real.log R2 - Real.log R1)).const_add T1
    exact h2.deriv
  refine ⟨fun r hr => ?_, by simp [T], ?_⟩
  swap
  · simp only [T]
    field_simp
    ring
  have hev : (fun y => y * deriv T y) =ᶠ[nhds r]
      fun _ => (T2 - T1) / (Real.log R2 - Real.log R1) := by
    filter_upwards [lt_mem_nhds hr] with y hy
    rw [hd y hy.ne']
    field_simp
  rw [hev.deriv_eq]
  simp

/-- The sphere: `C = (C2 R2 - C1 R1)/(R2 - R1) + (C1 - C2) R1 R2/((R2 - R1) r)`
has `d/dr (r² dC/dr) = 0` for `r > 0` and the boundary values. -/
theorem sphere_profile (C1 C2 R1 R2 : ℝ) (h1 : R1 ≠ 0) (h2 : R2 ≠ 0)
    (h12 : R2 - R1 ≠ 0) :
    let C : ℝ → ℝ := fun r =>
      (C2 * R2 - C1 * R1) / (R2 - R1) + (C1 - C2) * R1 * R2 / ((R2 - R1) * r)
    (∀ r, 0 < r → deriv (fun y => y ^ 2 * deriv C y) r = 0) ∧
      C R1 = C1 ∧ C R2 = C2 := by
  intro C
  have hd : ∀ y, y ≠ 0 →
      deriv C y = -((C1 - C2) * R1 * R2 / (R2 - R1)) / y ^ 2 := by
    intro y hy
    have hC : C = fun r => (C2 * R2 - C1 * R1) / (R2 - R1) +
        (C1 - C2) * R1 * R2 / (R2 - R1) * r⁻¹ := by
      funext r
      simp only [C]
      rw [div_mul_eq_div_div, div_eq_mul_inv ((C1 - C2) * R1 * R2 / (R2 - R1))]
    rw [hC]
    have := ((hasDerivAt_inv hy).const_mul
      ((C1 - C2) * R1 * R2 / (R2 - R1))).const_add
      ((C2 * R2 - C1 * R1) / (R2 - R1))
    rw [this.deriv]
    ring
  refine ⟨fun r hr => ?_, ?_, ?_⟩
  · have hev : (fun y => y ^ 2 * deriv C y) =ᶠ[nhds r]
        fun _ => -((C1 - C2) * R1 * R2 / (R2 - R1)) := by
      filter_upwards [lt_mem_nhds hr] with y hy
      rw [hd y hy.ne']
      field_simp
    rw [hev.deriv_eq]
    simp
  · simp only [C]
    field_simp
    ring
  · simp only [C]
    field_simp
    ring

/-! ## 4.  The double pendulum's normal modes -/

/-- Both squared frequencies the reading prints are roots of
`det (K - w² M)` for `M = l [[2, 1], [1, 1]]`, `K = g [[2, 0], [0, 1]]`. -/
theorem double_pendulum_modes (g l : ℝ) (hl : l ≠ 0) :
    ∀ w2 ∈ ({(2 + Real.sqrt 2) * g / l, (2 - Real.sqrt 2) * g / l} : Set ℝ),
      !![2 * g - w2 * (2 * l), 0 - w2 * l; 0 - w2 * l, g - w2 * l].det = 0 := by
  have hs : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  intro w2 hw
  rw [Matrix.det_fin_two_of]
  rcases hw with rfl | hw
  · have hu : (2 + Real.sqrt 2) * g / l * l = (2 + Real.sqrt 2) * g := by
      field_simp
    linear_combination ((2 + Real.sqrt 2) * g / l * l + (2 + Real.sqrt 2) * g
      - 4 * g) * hu + g ^ 2 * hs
  · rw [Set.mem_singleton_iff] at hw
    subst hw
    have hu : (2 - Real.sqrt 2) * g / l * l = (2 - Real.sqrt 2) * g := by
      field_simp
    linear_combination ((2 - Real.sqrt 2) * g / l * l + (2 - Real.sqrt 2) * g
      - 4 * g) * hu + g ^ 2 * hs

end GLM.Derivations
