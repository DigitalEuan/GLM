import RequestProject.GolayWeights

/-!
# Complete (nearest-codeword) Golay decoding

The substrate's `snap_to_codeword` only corrects error patterns of Hamming
weight `≤ 3`: when the syndrome's coset leader has weight `4` it returns its
input **unchanged**, so the "snapped" word is not a codeword at all.  This file
supplies the corrected engine and proves that it always works:

* `LatticeShortcut.golay_covering_radius` — every 24-bit word is within Hamming
  distance `4` of a codeword (covering radius `4`), so a complete decoder never
  fails;
* `LatticeShortcut.decode_isGolay` / `decode_dist_le_four` — the decoder
  implemented here (syndrome + coset-leader table) always returns a codeword at
  distance `≤ 4`;
* `LatticeShortcut.decode_eq_self_of_golay` — it fixes codewords;
* `LatticeShortcut.substrate_snap_fails` — an explicit 24-bit word whose
  distance to the code is `4`, on which the weight-`≤ 3` corrector of the
  substrate returns a non-codeword;
* `LatticeShortcut.decoding_not_unique` — at distance `4` the nearest codeword
  is not unique, so a complete decoder must fix a tie-breaking convention.
-/

namespace LatticeShortcut

set_option maxRecDepth 10000
set_option maxHeartbeats 4000000

/-- Syndrome of a 24-bit word: the (12-bit) discrepancy between the word and
the re-encoding of its information part. -/
def syn (v : ℕ) : ℕ := (v ^^^ cw (v % 4096)) >>> 12

/-- Table of minimum-weight coset leaders, packed as one natural number:
the leader of syndrome `s` occupies bits `24s .. 24s+23`. -/
def leaderNat : ℕ :=
  

/-- Minimum-weight coset leader of the syndrome `s`. -/
def leader (s : ℕ) : ℕ := leaderNat / 2 ^ (24 * s) % 2 ^ 24

/-- Complete decoder: subtract the coset leader of the syndrome. -/
def decode (v : ℕ) : ℕ := v ^^^ leader (syn v)

/-! ### The syndrome map -/

theorem syn_xor (a b : ℕ) : syn (a ^^^ b) = syn a ^^^ syn b := by
  unfold syn
  rw [show (4096 : ℕ) = 2 ^ 12 by norm_num, Nat.xor_mod_two_pow, cw_xor,
    xor4, Nat.shiftRight_xor_distrib]

theorem syn_lt {v : ℕ} (h : v < 2 ^ 24) : syn v < 4096 := by
  have hx : v ^^^ cw (v % 4096) < 2 ^ 24 := Nat.xor_lt_two_pow h (cw_lt _)
  rw [syn, Nat.shiftRight_eq_div_pow]
  omega

theorem syn_eq_zero_iff {v : ℕ} : syn v = 0 ↔ IsGolay v := by
  have hm : cw (v % 4096) % 4096 = v % 4096 := cw_mod _ (Nat.mod_lt _ (by norm_num))
  have hmod : (v ^^^ cw (v % 4096)) % 4096 = 0 := by
    rw [show (4096 : ℕ) = 2 ^ 12 by norm_num] at hm ⊢
    rw [Nat.xor_mod_two_pow, hm, Nat.xor_self]
  constructor
  · intro h
    rw [syn, Nat.shiftRight_eq_div_pow] at h
    have hlt : v ^^^ cw (v % 4096) < 4096 := by
      have := Nat.lt_of_div_eq_zero (by norm_num : 0 < 2 ^ 12) h
      simpa using this
    have hzero : v ^^^ cw (v % 4096) = 0 := by omega
    have : v = cw (v % 4096) := by
      have := Nat.xor_eq_zero_iff.1 hzero
      exact this
    exact (isGolay_iff v).2 this.symm
  · intro h
    have hv : cw (v % 4096) = v := (isGolay_iff v).1 h
    rw [syn, hv, Nat.xor_self]
    simp

/-! ### The coset-leader table -/

theorem leader_check :
    ((List.range 4096).all fun s =>
      decide (pop (leader s) ≤ 4) && (syn (leader s) == s) && decide (leader s < 2 ^ 24))
      = true := by decide +kernel

theorem leader_props {s : ℕ} (h : s < 4096) :
    pop (leader s) ≤ 4 ∧ syn (leader s) = s ∧ leader s < 2 ^ 24 := by
  have h2 := List.all_eq_true.1 leader_check s (List.mem_range.mpr h)
  simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h2
  exact ⟨h2.1.1, h2.1.2, h2.2⟩

/-! ### Correctness of the complete decoder -/

theorem decode_lt {v : ℕ} (h : v < 2 ^ 24) : decode v < 2 ^ 24 :=
  Nat.xor_lt_two_pow h (leader_props (syn_lt h)).2.2

/-- The complete decoder always returns a codeword. -/
theorem decode_isGolay {v : ℕ} (h : v < 2 ^ 24) : IsGolay (decode v) := by
  have hs := leader_props (syn_lt h)
  have : syn (decode v) = 0 := by
    rw [decode, syn_xor, hs.2.1, Nat.xor_self]
  exact syn_eq_zero_iff.1 this

/-- ... at Hamming distance at most `4`. -/
theorem decode_dist_le_four (v : ℕ) (h : v < 2 ^ 24) : pop (v ^^^ decode v) ≤ 4 := by
  have hs := leader_props (syn_lt h)
  have hxor : v ^^^ decode v = leader (syn v) := by
    rw [decode, ← Nat.xor_assoc, Nat.xor_self, Nat.zero_xor]
  rw [hxor]
  exact hs.1

/-- The decoder fixes codewords. -/
theorem decode_eq_self_of_golay {c : ℕ} (h : IsGolay c) : decode c = c := by
  have h0 : syn c = 0 := syn_eq_zero_iff.2 h
  have hl : leader 0 = 0 := by decide
  rw [decode, h0, hl, Nat.xor_zero]

/-- **Covering radius 4.**  Every 24-bit word is within Hamming distance `4` of
a Golay codeword, so a complete decoder never fails to snap. -/
theorem golay_covering_radius (v : ℕ) (h : v < 2 ^ 24) :
    ∃ c, IsGolay c ∧ pop (v ^^^ c) ≤ 4 :=
  ⟨decode v, decode_isGolay h, decode_dist_le_four v h⟩

/-! ### Why the substrate's weight-`≤ 3` corrector is not enough -/

theorem dist_15_check : ((List.range 4096).all fun m => decide (4 ≤ pop (15 ^^^ cw m)))
    = true := by decide +kernel

/-- The word `15` (four adjacent bits set) is at distance exactly `4` from the
code.  A corrector that only handles error patterns of weight `≤ 3` therefore
returns it unchanged — and it is not a codeword.  This is the defect that makes
44% of the substrate's "snapped" states fall off the code. -/
theorem substrate_snap_fails : ¬ IsGolay 15 ∧ ∀ c, IsGolay c → 4 ≤ pop (15 ^^^ c) := by
  have key : ∀ c, IsGolay c → 4 ≤ pop (15 ^^^ c) := by
    rintro c ⟨m, hm, rfl⟩
    have h2 := List.all_eq_true.1 dist_15_check m (List.mem_range.mpr hm)
    simpa using h2
  refine ⟨fun h => ?_, key⟩
  have h15 := key 15 h
  rw [Nat.xor_self] at h15
  simp [pop, bit] at h15

/-- Nearest-codeword decoding is not unique at distance `4`: the word `15` has
two distinct codewords at distance `4`.  A complete decoder must therefore fix a
tie-breaking convention (the table above picks one leader per syndrome). -/
theorem decoding_not_unique :
    ∃ c₁ c₂, IsGolay c₁ ∧ IsGolay c₂ ∧ c₁ ≠ c₂ ∧
      pop (15 ^^^ c₁) = 4 ∧ pop (15 ^^^ c₂) = 4 :=
  ⟨0, 10616863, golay_zero, (isGolay_iff _).2 (by decide), by decide, by decide, by decide⟩

end LatticeShortcut
