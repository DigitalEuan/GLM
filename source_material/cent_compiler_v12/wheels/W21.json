      "expected_derivable": true,
      "physical_status": "physically_supported",
      "expected_dimensional_explicit": null,
      "note": ""
    },
    {
      "id": "W21-02",
      "equation": "crack_length = (stress_intensity_factor / (dimensionless_factor * stress))^2",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "physically_supported",
      "expected_dimensional_explicit": null,
      "note": ""
    },
