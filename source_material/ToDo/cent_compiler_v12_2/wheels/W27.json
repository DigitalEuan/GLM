{
  "id": "W27",
  "title": "Cosmology & Cosmic Expansion",
  "axioms": [
    "recession_velocity = hubble_constant * distance",
    "critical_density = hubble_constant^2 / gravitational_constant",
    "hubble_time = 1 / hubble_constant",
    "horizon_distance = speed_of_light / hubble_constant"
  ],
  "cases": [
    {
      "id": "W27-01",
      "equation": "hubble_constant = recession_velocity / distance",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "model_convention",
      "expected_dimensional_explicit": null,
      "note": "Inverse of the local Hubble law v = H0*d; no relativistic correction or peculiar velocity is declared."
    },
    {
      "id": "W27-02",
      "equation": "critical_density = hubble_constant^2 / gravitational_constant",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "model_convention",
      "expected_dimensional_explicit": null,
      "note": "Critical density rho_c = 3*H0^2/(8*pi*G); the monomial convention omits the dimensionless 3/(8*pi) factor."
    },
    {
      "id": "W27-03",
      "equation": "hubble_time = 1 / hubble_constant",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "physically_supported",
      "expected_dimensional_explicit": null,
      "note": "Definition of the Hubble time."
    },
    {
      "id": "W27-04",
      "equation": "horizon_distance = speed_of_light / hubble_constant",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "physically_supported",
      "expected_dimensional_explicit": null,
      "note": "Definition of the Hubble horizon distance c/H0."
    },
    {
      "id": "W27-N1",
      "equation": "recession_velocity = hubble_constant / distance",
      "expected_dimensional": false,
      "expected_derivable": false,
      "physical_status": "negative_control",
      "expected_dimensional_explicit": null,
      "note": "Negative control: dividing by distance instead of multiplying breaks the Hubble-law dimensions."
    }
  ],
  "quantities": [
    "recession_velocity",
    "hubble_constant",
    "distance",
    "critical_density",
