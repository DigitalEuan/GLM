+/-- Pointwise vector addition. -/
+def addVec (x v : List Int) : List Int := x.zipWith (· + ·) v
+
+/-- Shift one coordinate. -/
+def bumpAt : List Int → Nat → Int → List Int
+  | [], _, _ => []
+  | v :: rest, i, d => if i == 0 then (v + d) :: rest else v :: bumpAt rest (i - 1) d
+
