+/-! ## The membership predicate, from the construction -/
+
+/-- The positions of `x` whose coordinate is `res` (mod 4), as a 24-bit
+mask. -/
+def supAux : List Int → Int → Nat → Nat → Nat
+  | [], _, _, acc => acc
+  | v :: rest, res, i, acc =>
+    supAux rest res (i + 1) (if v % 4 == res then acc ^^^ (1 <<< i) else acc)
+
+/-- The support of residue `res` (mod 4): `{i : x_i = res (mod 4)}` as a
+mask. -/
+def support (x : List Int) (res : Int) : Nat := supAux x res 0 0
+
+/-- One parity for every coordinate. -/
+def sameParity (x : List Int) : Bool :=
+  match x with
+  | [] => true
+  | v :: rest => rest.all (fun w => w % 2 == v % 2)
+
+/-- The common parity `m`. -/
+def parityOf (x : List Int) : Int :=
+  match x with
+  | [] => 0
+  | v :: _ => v % 2
+
+def sumOf (x : List Int) : Int := x.foldl (fun s v => s + v) 0
+
+/-- The Conway–Sloane membership predicate of Λ₂₄ (integer model): one
+parity, both mod-4 supports Golay codewords, sum = 4m (mod 8). -/
+def inLeech (x : List Int) : Bool :=
+  let m := parityOf x
+  sameParity x && golayWords.contains (support x 2)
+    && golayWords.contains (support x 3)
+    && (sumOf x - 4 * m) % 8 == 0
+
