{
 "id": "W42",
 "title": "Elastic Buckling and Bistable Snap-Through",
 "axioms": [
  "critical_load = youngs_modulus * moment_of_inertia_of_section / length^2",
  "snap_through_state = sign_of(applied_load - critical_load)",
  "hysteresis_band = release_load_fraction * critical_load"
 ],
 "cases": [
  {
   "id": "W42-01",
   "equation": "critical_load = youngs_modulus * moment_of_inertia_of_section / length^2",
   "expected_dimensional": true,
   "expected_derivable": true,
   "physical_status": "physically_supported",
   "expected_dimensional_explicit": null,
   "note": "Euler buckling of a pin-ended column; end-condition factors are separate conventions"
  },
  {
   "id": "W42-02",
   "equation": "snap_through_state = sign_of(applied_load - critical_load)",
   "expected_dimensional": true,
   "expected_derivable": true,
   "physical_status": "physically_supported",
   "expected_dimensional_explicit": null,
   "note": "the three-level law: below critical the state is -1 (initial well), at critical 0, above critical +1 (snapped-through well)"
  },
  {
   "id": "W42-03",
   "equation": "hysteresis_band = release_load_fraction * critical_load",
   "expected_dimensional": true,
   "expected_derivable": true,
   "physical_status": "physically_supported",
   "expected_dimensional_explicit": null,
   "note": "the snapped state releases at a lower load than it formed; the fraction is the declared hysteresis"
  },
  {
   "id": "W42-N1",
   "equation": "critical_load = youngs_modulus * area / length^2",
   "expected_dimensional": false,
   "expected_derivable": false,
   "physical_status": "negative_control",
   "expected_dimensional_explicit": null,
   "note": "missing the section moment of inertia; Euler critical load is not EA/L^2"
  }
 ],
