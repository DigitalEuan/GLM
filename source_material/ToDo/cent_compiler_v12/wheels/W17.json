{
  "id": "W17",
  "title": "Gravitation and orbital mechanics",
  "axioms": [
    "surface_gravity = gravitational_constant * source_mass / distance^2",
    "period^2 = distance^3 / (gravitational_constant * source_mass)"
  ],
  "cases": [
