{
  "id": "W26",
  "title": "Astrophysics & Stellar Structure",
  "axioms": [
    "luminosity = stefan_boltzmann_constant * radius^2 * temperature^4",
    "schwarzschild_radius = 2 * gravitational_constant * mass / speed_of_light^2",
    "orbital_velocity^2 = gravitational_constant * mass / orbital_radius",
    "hawking_temperature = hbar * speed_of_light^3 / (gravitational_constant * mass * boltzmann_constant)"
  ],
  "cases": [
    {
      "id": "W26-01",
      "equation": "stefan_boltzmann_constant = luminosity / (radius^2 * temperature^4)",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "model_convention",
      "expected_dimensional_explicit": null,
      "note": "Inverse of the blackbody luminosity law L = 4*pi*R^2*sigma*T^4; the monomial convention omits 4*pi and is checked on its displayed dimensions."
    },
    {
      "id": "W26-02",
      "equation": "mass = schwarzschild_radius * speed_of_light^2 / (2 * gravitational_constant)",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "physically_supported",
      "expected_dimensional_explicit": null,
      "note": "Exact algebraic inverse of r_s = 2GM/c^2."
    },
    {
      "id": "W26-03",
      "equation": "orbital_radius = gravitational_constant * mass / orbital_velocity^2",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "physically_supported",
      "expected_dimensional_explicit": null,
      "note": "Exact algebraic inverse of the circular-orbit relation v^2 = GM/r."
    },
    {
      "id": "W26-04",
      "equation": "mass = hbar * speed_of_light^3 / (gravitational_constant * boltzmann_constant * hawking_temperature)",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "model_convention",
      "expected_dimensional_explicit": null,
      "note": "Inverse of the Hawking temperature T_H = hbar*c^3/(8*pi*G*M*k_B); the monomial convention omits 8*pi."
    },
    {
      "id": "W26-N1",
      "equation": "luminosity = stefan_boltzmann_constant * radius^2 / temperature^4",
      "expected_dimensional": false,
      "expected_derivable": false,
      "physical_status": "negative_control",
      "expected_dimensional_explicit": null,
      "note": "Negative control: inverting the temperature power breaks the exact Stefan-Boltzmann dimensions."
    }
  ],
