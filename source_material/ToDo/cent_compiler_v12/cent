def _print_json(payload: dict) -> None:
    """Print a compiler payload with its certificate-or-gap block."""
    print(json.dumps(attach_certificate(payload), ensure_ascii=False, indent=2))


def cmd_compile(formula: str, top_n: int = 6, json_output: bool = False) -> int:
    """Compile a £ formula through the full pipeline."""
    if json_output:
        try:
            payload = ui_module.compile_payload(formula, top_n=top_n)
        except (SyntaxError, ValueError, CentError) as exc:
            print(render_parse_error(exc, formula), file=sys.stderr)
            return 2
        _print_json(payload)
        return 0

    print("=" * 70)
    print(f"COMPILING: {formula}")
    print("=" * 70)

    # Parse the formula to extract target and expression
    if "=" in formula:
        target, expr = formula.split("=", 1)
        target = target.strip()
        expr = expr.strip()
    else:
        target = "result"
        expr = formula.strip()

    # Preprocess: convert sqrt(x) → x**0.5, exp/log/tanh handled by decomposer
    import re
    expr = re.sub(r'\bsqrt\s*\(([^)]+)\)', r'(\1)**(1/2)', expr)

    # Step 1: decompose to ¢ DAG
    print("\n1. ¢ DAG decomposition:")
    try:
        dag = decompose_formula(expr, target)
        for op in dag.ops:
            c = f", const={op.const}" if op.const else ""
            print(f"   {op.op}({op.inputs}) → {op.output}{c}")
    except (SyntaxError, ValueError) as exc:
        print(render_parse_error(exc, expr), file=sys.stderr)
        return 2

    # Step 2: enumerate ∆ implementations
    print(f"\n2. ∆ enumeration:")
    impls = enumerate_delta(dag)
    ds_impls = [i for i in impls if i.is_delta_sigma]
    print(f"   {len(impls)} total ∆ implementations")
    print(f"   {len(ds_impls)} are delta-sigma")
    print(f"   delta-sigma implementable: {'YES' if ds_impls else 'no'}")

    # Step 3: rank by cost
    print(f"\n3. Top {top_n} by ¢_cost (deduplicated by domain/carrier/∆Σ):")
    top = rank_and_prune(impls, top_n=top_n)
    print(f"   {'rank':<5}{'cost':<6}{'domain':<14}{'carrier':<12}{'∆Σ?':<5}components")
    print(f"   {'-'*75}")
    for i, (impl, cost) in enumerate(top):
        comps = ", ".join(impl.components)
        if len(comps) > 45: comps = comps[:42] + "..."
        ds = "YES" if impl.is_delta_sigma else "no"
        print(f"   {i+1:<5}{cost.total:<6}{impl.substrate_domain:<14}"
              f"{impl.carrier_type:<12}{ds:<5}{comps}")

    print(
        "\n   Proposal boundary: every ranked ∆ is a declared proposal, "
        "not a fabricated or measured device."
    )

    if top:
        impl, cost = top[0]
        print(
            f"\n   Rank-1 reason: {impl.substrate_domain}/{impl.carrier_type}; "
            f"{cost.render()}"
        )

    print("")
    for line in ui_module.render_fidelity_trace(
        ui_module.fidelity_trace(impl) for impl, _ in top
    ):
        print(line)

    # Step 4: emit SPICE netlist for rank-1
    if top:
        template_match = select_spice_template(dag)
        print(
            "\n4. SPICE netlist (structural selection; "
            f"proposal_effect={template_match.proposal_effect}):"
        )
        if template_match.template:
            netlist = generate_spice_netlist(template_match.template)
        else:
            netlist = (
                f"* No SPICE template: {template_match.detail}\n"
                "* Template gap only; ranked ∆ proposals are unchanged.\n"
            )
        print(netlist)

    transfer = ui_module.compile_transfer(dag.ops)
    if transfer:
        print("\n5. Validated transfer:")
        for line in ui_module.render_compile_transfer(transfer):
            print(f"   {line}")


