        flag = "PASS" if passed else "FAIL"
        print(f"  [{flag}] {name}")
    n_pass = sum(1 for _, p in results if p)
    print(f"\n  {n_pass}/{len(results)} simulations passed")
    return 0 if n_pass == len(results) else 1


def cmd_enumerate(formula: str):
    """Enumerate ALL ∆ implementations for a £."""
    import re
    if "=" in formula:
        target, expr = formula.split("=", 1)
        target = target.strip()
        expr = expr.strip()
    else:
        target = "result"
        expr = formula.strip()

    # Preprocess sqrt() → **(1/2)
    expr = re.sub(r'\bsqrt\s*\(([^)]+)\)', r'(\1)**(1/2)', expr)

    try:
        dag = decompose_formula(expr, target)
    except (SyntaxError, ValueError) as exc:
        print(render_parse_error(exc, expr), file=sys.stderr)
        return 2
    impls = enumerate_delta(dag)
    print(f"{len(impls)} ∆ implementations for: {formula}")
    for i, impl in enumerate(impls):
        ds = " [∆Σ]" if impl.is_delta_sigma else ""
        print(f"  {i+1:>3}. [{impl.substrate_domain:<12}] "
              f"{impl.carrier_type:<12}{ds}  {', '.join(impl.components)}")


def cmd_spice(formula: str, out_dir: str | None = None):
    """Emit SPICE netlist for a £ and write to disk."""
    import re
    if "=" in formula:
        target, expr = formula.split("=", 1)
        target = target.strip()
        expr = expr.strip()
    else:
        target = "result"
        expr = formula.strip()

    # Preprocess sqrt() → **(1/2), exp() stays as call (handled by decomposer)
    expr = re.sub(r'\bsqrt\s*\(([^)]+)\)', r'(\1)**(1/2)', expr)

    try:
        dag = decompose_formula(expr, target)
    except (SyntaxError, ValueError) as exc:
        print(render_parse_error(exc, expr), file=sys.stderr)
        return 2
    template_match = select_spice_template(dag)
    if not template_match.template:
        print(f"* No SPICE template: {template_match.detail}")
        return
    netlist = generate_spice_netlist(template_match.template)
    filename = {
        "opamp_sqrt": "sqrt_extractor.cir",
        "delta_sigma": "delta_sigma.cir",
        "rc_integrator": "rc_integrator.cir",
        "kcl_summer": "kcl_summer.cir",
    }.get(template_match.template, f"{template_match.template}.cir")

    print(netlist)
    # Write to disk
    if out_dir:
        os.makedirs(out_dir, exist_ok=True)
    filepath = os.path.join(out_dir or os.getcwd(), filename)
    with open(filepath, "w") as f:
        f.write(netlist)
    print(f"\n* Netlist written to: {filepath}")


