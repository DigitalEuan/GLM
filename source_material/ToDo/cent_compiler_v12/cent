def cmd_eval(path: str, ticks: int = 1, sets=None, seed: int = 0) -> int:
    """Run an exact-core material bundle or program."""
    material = ui_module.load_material(path)
    overrides = {}
    for item in sets or []:
        if "=" not in item:
            print(f"error: --set expects name=value, got {item!r}", file=sys.stderr)
            return 2
        name, raw = item.split("=", 1)
        try:
            overrides[name.strip()] = Fraction(raw.strip())
        except (ValueError, ZeroDivisionError):
            print(f"error: {raw!r} is not an exact rational", file=sys.stderr)
            return 2
    try:
        rows = ui_module.run_material(
            material, ticks=ticks, overrides=overrides, seed=seed
        )
    except CentError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    for index, row in enumerate(rows):
        rendered = ", ".join(
            f"{name} = {ui_module.format_value(value)}" for name, value in row.items()
        )
        print(f"t={index}  {rendered}")
    return 0


