def _parse_hypothesis_answers(items: list[str]) -> dict[str, str]:
    answers: dict[str, str] = {}
    for item in items:
        if "=" not in item:
            raise ValueError("answers must use ID=text, for example q1=path/to/proof")
        key, value = item.split("=", 1)
        key = key.strip()
        value = value.strip()
        if not key or not value:
            raise ValueError("answers must use a non-empty ID and text")
        answers[key] = value
    return answers


def cmd_hypothesis_resolve(lead_id: str, answer_items: list[str],
                           decision: str | None, note: str,
                           json_output: bool = False) -> int:
    """Ask for missing needs, retry, then record keep or retire."""
    try:
        answers = _parse_hypothesis_answers(answer_items)
    except ValueError as exc:
        print(f"hypothesis: {exc}", file=sys.stderr)
        return 2

    while True:
        try:
            payload = hypotheses_module.resolve_lead(
                lead_id, answers, decision, note
            )
        except ValueError as exc:
            print(f"hypothesis: {exc}", file=sys.stderr)
            return 2

        if json_output or not sys.stdin.isatty():
            if json_output:
                _print_json(payload)
            else:
                print(hypotheses_module.render_resolution(payload))
            return 0 if payload["status"] in {"retained", "retired"} else 1

        if payload["status"] == "needs_input":
            question = payload["next_question"]
            answer = input(f"{question['prompt']}\n[{question['id']}] > ").strip()
            if answer:
                answers[question["id"]] = answer
            continue
        if payload["status"] == "ready_for_decision":
            choice = input("Decision [keep/retire] (keep): ").strip().lower() or "keep"
            if choice not in {"keep", "retire"}:
                print("Please enter 'keep' or 'retire'.", file=sys.stderr)
                continue
            decision = choice
            if choice == "retire":
                note = input("Retirement reason: ").strip()
            continue
        if payload["status"] == "needs_note":
            note = input("Retirement reason: ").strip()
            continue
        print(hypotheses_module.render_resolution(payload))
        return 0


