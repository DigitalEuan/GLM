def cmd_explore(topic: str, json_output: bool = False,
                declarations_path: str | None = None,
                glm_output: bool = False) -> int:
    """Run the isolated ideal-law laboratory for alternative arithmetic methods."""
    if topic != "addition":
        print(f"explore: unknown topic {topic!r}; choose from addition", file=sys.stderr)
        return 2
    declarations = None
    if declarations_path:
        try:
            with open(declarations_path, encoding="utf-8") as handle:
                declarations = json.load(handle)
        except (OSError, json.JSONDecodeError) as exc:
            print(f"explore: cannot read declarations {declarations_path!r}: {exc}", file=sys.stderr)
            return 2
        if not isinstance(declarations, dict):
            print("explore: declarations must be a JSON object", file=sys.stderr)
            return 2
    payload = addition_lab_module.build_payload(declarations)
    if glm_output:
        evidence = addition_lab_module.glm_evidence(payload)
        if json_output:
            print(json.dumps(evidence, ensure_ascii=False, indent=2))
        else:
            print(addition_lab_module.render_glm_evidence(evidence))
        return 0 if evidence["summary"]["methods_passed"] == evidence["summary"]["methods"] else 1
    if json_output:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print(addition_lab_module.render_text(payload))
    return 0 if payload["summary"]["all_exact_vectors_passed"] else 1


