def cmd_knowledge(
    action: str,
    query_words: list[str],
    json_output: bool = False,
    limit: int = knowledge_module.DEFAULT_LIMIT,
    full: bool = False,
    min_chars: int = knowledge_module.DEFAULT_MIN_CHARS,
) -> int:
    """Address document sections, find parts, or stitch a reading path."""
    root = os.path.dirname(os.path.abspath(__file__))
    atlas = knowledge_module.build_atlas(root)
    query = " ".join(query_words).strip()

    if action == "atlas":
        payload = atlas.payload(include_body=full)
        if json_output:
            print(json.dumps(payload, ensure_ascii=False, indent=2))
        else:
            print(knowledge_module.render_atlas(atlas))
        return 0

    if action == "duplicates":
        groups = knowledge_module.duplicate_groups(atlas, min_chars=min_chars)
        payload = {
            "ok": True,
            "schema": knowledge_module.SCHEMA,
            "groups": groups,
            "summary": atlas.summary(),
        }
        if json_output:
            print(json.dumps(payload, ensure_ascii=False, indent=2))
        else:
            print(knowledge_module.render_duplicates(payload))
        return 0

    if not query:
        print(f"knowledge: {action} needs a query", file=sys.stderr)
        return 2

    if action == "find":
        matches = knowledge_module.find_parts(atlas, query, limit=limit)
        payload = {
            "ok": bool(matches),
            "schema": knowledge_module.SCHEMA,
            "query": query,
            "matches": [part.public() for part in matches],
        }
        if json_output:
            print(json.dumps(payload, ensure_ascii=False, indent=2))
        else:
            print(knowledge_module.render_find(payload))
        return 0 if matches else 1

    if all(word.startswith(knowledge_module.ADDRESS_PREFIX) for word in query_words):
        payload = knowledge_module.stitch_addresses(
            atlas, query_words, full=full
        )
    else:
        payload = knowledge_module.stitch(
            atlas, query, limit=limit, full=full
        )
    if json_output:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print(knowledge_module.render_stitch(payload))
    return 0 if payload.get("ok") else 1


