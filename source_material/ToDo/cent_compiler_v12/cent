#!/usr/bin/env python3
"""
cent — the £ → ¢ → ∆ computational transfer compiler CLI.

Usage:
    cent compile "<£ formula>"
    cent compile "velocity = (2 * energy / mass)^(1/2)"
    cent compile "y = sqrt(5)"
    cent compile "y = sqrt(5)" --json
    cent guide                        # show £ syntax and the ¢ → ∆ pipeline
    cent discover "<problem>"         # find declared methods for a problem statement
    cent matrix                       # declared operation × method evidence matrix
    cent explore addition             # ideal-law lab for alternative adder/subtractor methods
    cent mechanism list               # seeded cross-domain mechanism registry
    cent mechanism delta-sigma-error-feedback --json  # one mechanism card
    cent transfer "sqrt" --target glm-reference --json  # retrieve transfer candidates
    cent transfer "quantized_carry" --validate --json   # run the reference target certificate
    cent evaluate --json             # measure the declared retrieval corpus
    cent propose "sqrt" --target glm-reference --json   # portable cross-domain proposal bundle
    cent propose "sqrt" --target glm-reference --out proposals  # write reviewable files
    cent propose "sqrt" --trial      # run ready proposals over fixed vectors
    cent trial proposals              # side-loop: execute saved proposals
    cent trial --wheel                # spin through declared operations and trial them
    cent machine list                 # declare whole-machine concepts
    cent machine sigma-delta-sqrt     # compose and run the first machine
    cent knowledge atlas              # address every document section as a part
    cent knowledge stitch "trial wheel"  # assemble a reading path, not another doc
    cent review proposals --list     # durable proposal review ledger
    cent refute --json               # D5 Tier-D negatives and witness pairs
    cent holdout --json              # D6 frozen retrodictive holdout
    cent self --json                 # D4 measured self-transfer utility ledger
    cent-self --revert <id> --json   # exercise a declared rollback
    cent assemble delta-sigma        # build and simulate the carry route
    cent assemble sqrt-log           # build and simulate the log-domain compute route
    cent assemble sqrt-feedback      # build and solve the op-amp feedback compute route
    cent assemble sum-kcl            # exact KCL addition (--operation difference for subtraction)
    cent assemble sum-fluid          # exact fluid continuity addition
    cent assemble sum-opamp          # exact op-amp addition (--operation difference for subtraction)
    cent graph delta-sigma           # expand a selected route into a typed ¢ graph
    cent axioms                      # flatten the wheel axioms into one typed graph
    cent derive W5.power W38.input_torque W38.input_angular_velocity  # exact graph derivation
    cent moves corpus.json           # audit declared move bigrams and displacements
    cent leech-class --basis B.json --corpus corpus.json  # exact class-word audit
    cent envelope --point 0,1 --point 1,0 --point 0,-1 --point=-1,0  # exact orientation envelope
    cent pipeline sqrt               # decompose a route into stages and handoffs
    cent hypothesis bounding_box     # surface pre-admission matches without promotion
    cent hypothesis --resolve nematic-q-tensor-bounding-box --json  # ask/resolve a lead
    cent hypothesis --promote bresenham-quantized-carry --mechanism delta-sigma-error-feedback \
      --certificate cert.json --review review.json  # gated proposal promotion
    cent bind delta-sigma            # map a route to declared device quantities
    cent bind sqrt-log               # map the log-domain route to device quantities    cent bind sqrt-feedback      # map the feedback route to device quantities
    cent bind sum-kcl            # map the normalized KCL route to declared quantities
    cent solve sqrt-feedback         # select a declared design under exact constraints
    cent physical sqrt-log           # emit the reference netlist and schematic floorplan
    cent dynamics delta-sigma        # run the exact sampled-data RC/clock check
    cent showcase                    # delta-sigma irrational carrier demo
    cent test                        # run legacy 7-simulation suite
    cent enumerate "<£ formula>"    # enumerate all ∆ implementations
    cent spice "<£ formula>"         # emit SPICE netlist
    cent report "<£ formula>" [--save DIR]   # one-shot report + material bundle
    cent ui                          # interactive console (enter a £, read the report)
    cent web [--port P] [--host H]   # browser UI (localhost by default)
    cent eval <material.json>        # run the generated exact-core program

The CLI accepts a supported £ relation, decomposes it to a ¢ DAG,
enumerates declared ∆ candidates, checks if delta-sigma applies,
and emits a SPICE netlist for the chosen ∆.
