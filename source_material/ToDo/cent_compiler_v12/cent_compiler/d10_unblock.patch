+    # the last "N/N checks passed" line; D8's 17/17 above is informational).
+    print(f"ORIGINATION (D8+D9 COMBINED): {PASS}/{PASS + FAIL} checks passed")
+    print("=" * 78)
+    return 1 if FAIL else 0
