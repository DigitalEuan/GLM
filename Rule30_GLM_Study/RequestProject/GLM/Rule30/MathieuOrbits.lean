module

public import Mathlib

/-!
# Round 32: the Mathieu group `M₂₄` acting on seed patterns, and what Rule 30 keeps of it

The GLM's lattice-shortcut layer carries a binary Golay code `C` of length 24 (the generator rows
`G = [I₁₂ | B]` of `ShortcutNetworkData.golayRows`, repeated here so that this file is
self-contained).  Its automorphism group — the permutations of the 24 coordinates that map `C`
onto itself — is the Mathieu group `M₂₄` (classical; not re-proved here).  A *seed pattern* is a
24-bit word, read as a set of marked cells ("defects").  Permuting the cells by an automorphism
gives the **orbit** of the seed: the symmetrically related patterns.

This file holds the exact (`FORMAL`) part of the study; the finite certificates are in
`MathieuOrbitsData.lean`.

**Patterns and the action.**
* `pmask σ x` — the pattern `x` with its cells moved by the permutation `σ` of `Fin 24`
  (cell `i` goes to cell `σ i`).  It is XOR-linear (`pmask_xor`), keeps the number of marked cells
  (`weight_pmask`), and composes (`pmask_mul`).
* `code`, `PreservesCode σ` — the Golay code and its automorphisms.  `preservesCode_iff_rows`:
  checking the 12 generator rows decides whether `σ` is an automorphism (both directions), and
  `PreservesCode.symm`: the inverse of an automorphism is an automorphism (a counting argument).

**Orbits as words in generators.**
* `Reach gens x y` — `y` is obtained from `x` by applying generators one after another.
  `reach_invariant`: anything kept by every generator is kept along the orbit.
  `reach_mem_closure`: every reached pattern is the image of the seed under an element of the
  subgroup generated by `gens`.
* `certOK` and `certOK_reach` — a **checkable orbit certificate** (a breadth-first tree with
  parent pointers).  If the certificate checks, every pattern listed in it is in the orbit.  This
  is how the orbits in `MathieuOrbitsData.lean` are certified, and it is the reusable tool for the
  GLM: any seed, any generators.

**What Rule 30 keeps of the symmetry.**  Rule 30 on a ring of 24 cells is `ring30`
(cell `j` reads cells `j - 1, j, j + 1`, indices mod 24).
* `rot_commutes` — every rotation of the ring commutes with Rule 30.
* **`commutes_iff_rot`** — and *only* rotations do: a permutation of the 24 cells that commutes
  with Rule 30 on every pattern is a rotation.  Reflections fail because Rule 30 is chiral (its
  mirror is Rule 86).  So the symmetries that carry Rule 30 futures to Rule 30 futures form the
  cyclic group of order 24 — nothing more of `M₂₄` can ever be transported to the dynamics.
* `transport_iterate` — the abstract principle: a symmetry that commutes with one step carries
  whole futures; this is exactly what the orbit of a seed means for the dynamics.
* `shared_card_le_of_not_one` — once the one-step rotation is excluded, at most 12 symmetries
  can be both code automorphisms and Rule 30 symmetries (a pigeonhole argument in `ℤ/24`).
-/

@[expose] public section

namespace GLM.Rule30.Mathieu

/-! ## 24-bit patterns -/

/-- Little-endian bits to a natural number. -/
def ofBits : List Bool → ℕ
  | [] => 0
  | b :: bs => Nat.bit b (ofBits bs)

theorem testBit_ofBits (l : List Bool) (j : ℕ) : (ofBits l).testBit j = l.getD j false := by
  induction l generalizing j with
  | nil => simp [ofBits]
  | cons b bs ih =>
    cases j with
    | zero => simp [ofBits]
    | succ j => simp [ofBits, Nat.testBit_bit_succ, ih]

/-- The 24-cell pattern whose cell `i` is `f i`. -/
def mk24 (f : Fin 24 → Bool) : ℕ := ofBits ((List.finRange 24).map f)

theorem testBit_mk24 (f : Fin 24 → Bool) (j : ℕ) :
    (mk24 f).testBit j = if h : j < 24 then f ⟨j, h⟩ else false := by
  rw [mk24, testBit_ofBits]
  split_ifs with h
  · simp [List.getD_eq_getElem?_getD, h]
  · simp only [List.getD_eq_getElem?_getD, List.getElem?_map]
    rw [List.getElem?_eq_none (by simp; omega)]; rfl

theorem testBit_mk24_fin (f : Fin 24 → Bool) (i : Fin 24) : (mk24 f).testBit i = f i := by
  rw [testBit_mk24, dif_pos i.isLt]

theorem mk24_lt (f : Fin 24 → Bool) : mk24 f < 2 ^ 24 := by
  apply Nat.lt_pow_two_of_testBit
  intro i hi
  rw [testBit_mk24, dif_neg (by omega)]

theorem testBit_eq_false_of_lt {x : ℕ} (hx : x < 2 ^ 24) {j : ℕ} (hj : 24 ≤ j) :
    x.testBit j = false :=
  Nat.testBit_eq_false_of_lt (lt_of_lt_of_le hx (Nat.pow_le_pow_right (by norm_num) hj))

/-- Two patterns below `2^24` agreeing on the 24 cells are equal. -/
theorem eq_of_cells {x y : ℕ} (hx : x < 2 ^ 24) (hy : y < 2 ^ 24)
    (h : ∀ i : Fin 24, x.testBit i = y.testBit i) : x = y := by
  apply Nat.eq_of_testBit_eq
  intro j
  by_cases hj : j < 24
  · exact h ⟨j, hj⟩
  · rw [testBit_eq_false_of_lt hx (by omega), testBit_eq_false_of_lt hy (by omega)]

/-- Number of marked cells. -/
def weight (x : ℕ) : ℕ := ((List.finRange 24).filter (fun i : Fin 24 => x.testBit i.val)).length

theorem weight_eq_card (x : ℕ) :
    weight x = (Finset.univ.filter (fun i : Fin 24 => x.testBit i.val)).card := by
  rw [weight, ← List.toFinset_card_of_nodup ((List.nodup_finRange 24).filter _)]
  congr 1
  ext i; simp

/-! ## Moving the cells of a pattern -/

/-- The pattern `x` with cell `i` moved to cell `σ i`. -/
def pmask (σ : Equiv.Perm (Fin 24)) (x : ℕ) : ℕ := mk24 (fun j => x.testBit (σ.symm j))

theorem testBit_pmask (σ : Equiv.Perm (Fin 24)) (x : ℕ) (j : Fin 24) :
    (pmask σ x).testBit j = x.testBit (σ.symm j) := testBit_mk24_fin _ _

theorem testBit_pmask_apply (σ : Equiv.Perm (Fin 24)) (x : ℕ) (i : Fin 24) :
    (pmask σ x).testBit (σ i) = x.testBit i := by
  rw [testBit_pmask, Equiv.symm_apply_apply]

theorem pmask_lt (σ : Equiv.Perm (Fin 24)) (x : ℕ) : pmask σ x < 2 ^ 24 := mk24_lt _

theorem pmask_xor (σ : Equiv.Perm (Fin 24)) (x y : ℕ) :
    pmask σ (x ^^^ y) = pmask σ x ^^^ pmask σ y := by
  apply eq_of_cells (pmask_lt _ _) (Nat.xor_lt_two_pow (pmask_lt _ _) (pmask_lt _ _))
  intro i
  simp only [testBit_pmask, Nat.testBit_xor]

theorem pmask_zero (σ : Equiv.Perm (Fin 24)) : pmask σ 0 = 0 := by
  apply eq_of_cells (pmask_lt _ _) (by norm_num)
  intro i; simp [testBit_pmask]

theorem pmask_mul (σ τ : Equiv.Perm (Fin 24)) (x : ℕ) :
    pmask (σ * τ) x = pmask σ (pmask τ x) := by
  apply eq_of_cells (pmask_lt _ _) (pmask_lt _ _)
  intro i
  simp only [testBit_pmask, Equiv.Perm.mul_def, Equiv.symm_trans_apply]

theorem pmask_one {x : ℕ} (hx : x < 2 ^ 24) : pmask 1 x = x := by
  apply eq_of_cells (pmask_lt _ _) hx
  intro i; simp [testBit_pmask]

theorem pmask_symm_pmask (σ : Equiv.Perm (Fin 24)) {x : ℕ} (hx : x < 2 ^ 24) :
    pmask σ.symm (pmask σ x) = x := by
  rw [← pmask_mul]; simpa using pmask_one hx

theorem pmask_pmask_symm (σ : Equiv.Perm (Fin 24)) {x : ℕ} (hx : x < 2 ^ 24) :
    pmask σ (pmask σ.symm x) = x := by
  rw [← pmask_mul]; simpa using pmask_one hx

theorem pmask_injOn (σ : Equiv.Perm (Fin 24)) {x y : ℕ} (hx : x < 2 ^ 24) (hy : y < 2 ^ 24)
    (h : pmask σ x = pmask σ y) : x = y := by
  rw [← pmask_symm_pmask σ hx, h, pmask_symm_pmask σ hy]

/-- Moving cells keeps the number of marked cells. -/
theorem weight_pmask (σ : Equiv.Perm (Fin 24)) (x : ℕ) : weight (pmask σ x) = weight x := by
  rw [weight_eq_card, weight_eq_card]
  have : (Finset.univ.filter (fun i : Fin 24 => (pmask σ x).testBit i.val)) =
      (Finset.univ.filter (fun i : Fin 24 => x.testBit i.val)).map σ.toEmbedding := by
    ext j
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_map,
      Equiv.toEmbedding_apply, testBit_pmask]
    constructor
    · intro h; exact ⟨σ.symm j, h, by simp⟩
    · rintro ⟨a, ha, rfl⟩; simpa using ha
  rw [this, Finset.card_map]

/-! ## The GLM's Golay code -/

/-- The generator rows `G = [I₁₂ | B]` of the GLM lattice-shortcut layer, as 24-bit masks
(the same list as `ShortcutNetworkData.golayRows`). -/
def golayRows : List ℕ :=
  [16769025, 4681730, 10727428, 13750280, 6877200, 11825184,
   14299200, 15536256, 7770368, 3887616, 1946624, 9361408]

/-- XOR of the generator rows selected by the bits of `m`, starting from `acc`. -/
def golayFold (m : ℕ) (acc : ℕ) (js : List ℕ) : ℕ :=
  js.foldl (fun acc j => if m.testBit j then acc ^^^ golayRows.getD j 0 else acc) acc

/-- The codeword with message `m`. -/
def golayWord (m : ℕ) : ℕ := golayFold m 0 (List.range 12)

theorem golayFold_xor (m m' : ℕ) (js : List ℕ) :
    ∀ acc acc', golayFold (m ^^^ m') (acc ^^^ acc') js =
      golayFold m acc js ^^^ golayFold m' acc' js := by
  induction js with
  | nil => intro acc acc'; rfl
  | cons j js ih =>
    intro acc acc'
    simp only [golayFold, List.foldl_cons] at ih ⊢
    rw [Nat.testBit_xor]
    set r := golayRows.getD j 0
    cases hm : m.testBit j <;> cases hm' : m'.testBit j <;> simp only [Bool.false_xor,
      Bool.xor_false, Bool.true_xor, Bool.not_true, if_true, if_false,
      Bool.false_eq_true]
    · exact ih _ _
    · rw [← ih]; congr 1; ac_rfl
    · rw [← ih]; congr 1; ac_rfl
    · rw [← ih]; congr 1
      rw [Nat.xor_assoc, Nat.xor_comm r, Nat.xor_assoc, Nat.xor_self, Nat.xor_zero]

theorem golayWord_xor (m m' : ℕ) : golayWord (m ^^^ m') = golayWord m ^^^ golayWord m' := by
  unfold golayWord
  rw [← golayFold_xor, Nat.xor_self]

/-- The Golay code: the 4096 codewords. -/
def code : Set ℕ := {x | ∃ m < 4096, golayWord m = x}

/-- Exact membership test (the message is the low 12 bits, `G = [I₁₂ | B]`). -/
def isCode (x : ℕ) : Bool := golayWord (x % 4096) == x

/-- Certificate: the message of a codeword is its low 12 bits, and codewords have 24 bits. -/
theorem golayWord_low : ∀ m < 4096, golayWord m % 4096 = m ∧ golayWord m < 2 ^ 24 := by
  decide +kernel

theorem mem_code_iff (x : ℕ) : x ∈ code ↔ isCode x = true := by
  simp only [code, Set.mem_setOf_eq, isCode, beq_iff_eq]
  constructor
  · rintro ⟨m, hm, rfl⟩; rw [(golayWord_low m hm).1]
  · intro h; exact ⟨x % 4096, Nat.mod_lt _ (by norm_num), h⟩

theorem code_lt {x : ℕ} (hx : x ∈ code) : x < 2 ^ 24 := by
  obtain ⟨m, hm, rfl⟩ := hx; exact (golayWord_low m hm).2

theorem zero_mem_code : (0 : ℕ) ∈ code := ⟨0, by norm_num, by decide⟩

theorem xor_mem_code {x y : ℕ} (hx : x ∈ code) (hy : y ∈ code) : x ^^^ y ∈ code := by
  obtain ⟨m, hm, rfl⟩ := hx
  obtain ⟨m', hm', rfl⟩ := hy
  exact ⟨m ^^^ m', Nat.xor_lt_two_pow (n := 12) hm hm', golayWord_xor m m'⟩

theorem rows_isCode : golayRows.all isCode = true := by decide +kernel

theorem row_mem_code {r : ℕ} (hr : r ∈ golayRows) : r ∈ code := by
  rw [mem_code_iff]; exact List.all_eq_true.1 rows_isCode r hr

/-- `σ` is an automorphism of the code (an element of `M₂₄`). -/
def PreservesCode (σ : Equiv.Perm (Fin 24)) : Prop := ∀ x ∈ code, pmask σ x ∈ code

/-- The 12-row test. -/
def rowsOK (σ : Equiv.Perm (Fin 24)) : Bool := golayRows.all (fun r => isCode (pmask σ r))

theorem pmask_golayFold_mem (σ : Equiv.Perm (Fin 24))
    (hrows : ∀ r ∈ golayRows, pmask σ r ∈ code) (m : ℕ) :
    ∀ (js : List ℕ) (acc : ℕ), pmask σ acc ∈ code → pmask σ (golayFold m acc js) ∈ code := by
  intro js
  induction js with
  | nil => intro acc h; exact h
  | cons j js ih =>
    intro acc h
    simp only [golayFold, List.foldl_cons]
    apply ih
    split_ifs
    · rw [pmask_xor]
      apply xor_mem_code h
      by_cases hj : j < golayRows.length
      · rw [List.getD_eq_getElem _ _ hj]; exact hrows _ (List.getElem_mem hj)
      · rw [List.getD_eq_default _ _ (by omega), pmask_zero]; exact zero_mem_code
    · exact h

/-- **Checking the 12 rows decides membership in `M₂₄`.** -/
theorem preservesCode_iff_rows (σ : Equiv.Perm (Fin 24)) : PreservesCode σ ↔ rowsOK σ = true := by
  constructor
  · intro h
    simp only [rowsOK, List.all_eq_true]
    intro r hr; rw [← mem_code_iff]; exact h r (row_mem_code hr)
  · intro h
    have hrows : ∀ r ∈ golayRows, pmask σ r ∈ code := by
      intro r hr
      simp only [rowsOK, List.all_eq_true] at h
      rw [mem_code_iff]; exact h r hr
    rintro x ⟨m, -, rfl⟩
    exact pmask_golayFold_mem σ hrows m _ 0 (by rw [pmask_zero]; exact zero_mem_code)

/-- The code as a finite set. -/
def codeF : Finset ℕ := (Finset.range 4096).image golayWord

theorem mem_codeF {x : ℕ} : x ∈ codeF ↔ x ∈ code := by
  simp [codeF, code]

theorem codeF_card : codeF.card = 4096 := by
  rw [codeF, Finset.card_image_of_injOn, Finset.card_range]
  intro m hm m' hm' h
  have h1 := (golayWord_low m (Finset.mem_range.1 hm)).1
  have h2 := (golayWord_low m' (Finset.mem_range.1 hm')).1
  rw [← h1, ← h2, h]

/-- **The inverse of an automorphism is an automorphism** (the map is injective on the finite
code, so it is onto). -/
theorem PreservesCode.symm {σ : Equiv.Perm (Fin 24)} (h : PreservesCode σ) :
    PreservesCode σ.symm := by
  have himg : codeF.image (pmask σ) = codeF := by
    apply Finset.eq_of_subset_of_card_le
    · intro y hy
      obtain ⟨x, hx, rfl⟩ := Finset.mem_image.1 hy
      exact mem_codeF.2 (h x (mem_codeF.1 hx))
    · rw [Finset.card_image_of_injOn]
      intro x hx y hy hxy
      exact pmask_injOn σ (code_lt (mem_codeF.1 hx)) (code_lt (mem_codeF.1 hy)) hxy
  intro y hy
  rw [← mem_codeF, ← himg] at hy
  obtain ⟨x, hx, rfl⟩ := Finset.mem_image.1 hy
  rw [pmask_symm_pmask σ (code_lt (mem_codeF.1 hx))]
  exact mem_codeF.1 hx

theorem PreservesCode.mul {σ τ : Equiv.Perm (Fin 24)} (hσ : PreservesCode σ)
    (hτ : PreservesCode τ) : PreservesCode (σ * τ) := by
  intro x hx; rw [pmask_mul]; exact hσ _ (hτ _ hx)

/-! ## Orbits: words in the generators, and checkable certificates -/

/-- `Reach gens x y`: `y` is obtained from the seed `x` by applying generators in turn. -/
inductive Reach (gens : List (Equiv.Perm (Fin 24))) (x : ℕ) : ℕ → Prop
  | refl : Reach gens x x
  | step {y : ℕ} (g : Equiv.Perm (Fin 24)) : g ∈ gens → Reach gens x y → Reach gens x (pmask g y)

/-- Anything kept by every generator is kept along an orbit. -/
theorem reach_invariant {gens : List (Equiv.Perm (Fin 24))} (P : ℕ → Prop)
    (hP : ∀ g ∈ gens, ∀ y, P y → P (pmask g y)) {x y : ℕ} (hx : P x) (h : Reach gens x y) :
    P y := by
  induction h with
  | refl => exact hx
  | step g hg _ ih => exact hP g hg _ ih

theorem reach_trans {gens : List (Equiv.Perm (Fin 24))} {x y z : ℕ} (h1 : Reach gens x y)
    (h2 : Reach gens y z) : Reach gens x z := by
  induction h2 with
  | refl => exact h1
  | step g hg _ ih => exact Reach.step g hg ih

/-- Every reached pattern is the image of the seed under the subgroup generated by `gens`. -/
theorem reach_mem_closure {gens : List (Equiv.Perm (Fin 24))} {x y : ℕ} (hx : x < 2 ^ 24)
    (h : Reach gens x y) :
    ∃ σ ∈ Subgroup.closure {g | g ∈ gens}, pmask σ x = y := by
  induction h with
  | refl => exact ⟨1, Subgroup.one_mem _, pmask_one hx⟩
  | step g hg _ ih =>
    obtain ⟨σ, hσ, rfl⟩ := ih
    exact ⟨g * σ, Subgroup.mul_mem _ (Subgroup.subset_closure hg) hσ, pmask_mul _ _ _⟩

/-- Reach preserves membership of the code, if every generator is an automorphism. -/
theorem reach_code {gens : List (Equiv.Perm (Fin 24))} (hg : ∀ g ∈ gens, PreservesCode g)
    {x y : ℕ} (hx : x ∈ code) (h : Reach gens x y) : y ∈ code :=
  reach_invariant (· ∈ code) (fun g hgm y hy => hg g hgm y hy) hx h

theorem reach_weight {gens : List (Equiv.Perm (Fin 24))} {x y : ℕ} (h : Reach gens x y) :
    weight y = weight x :=
  reach_invariant (fun y => weight y = weight x) (fun g _ y hy => by show weight (pmask g y) = weight x; rw [weight_pmask, hy]) rfl h

/-- An orbit certificate: entry `i` is `(value, parent, generator)`, with `value` the image of
the parent's value under the generator; entry `0` is the seed. -/
def certOK (gens : List (Equiv.Perm (Fin 24))) (x : ℕ) (cert : Array (ℕ × ℕ × ℕ)) : Bool :=
  decide (0 < cert.size) && cert[0]!.1 == x &&
    (List.range cert.size).all fun i =>
      i == 0 || (decide (cert[i]!.2.1 < i) && decide (cert[i]!.2.2 < gens.length) &&
        cert[i]!.1 == pmask (gens.getD cert[i]!.2.2 1) cert[cert[i]!.2.1]!.1)

/-- **Soundness of orbit certificates**: every value listed is in the orbit of the seed. -/
theorem certOK_reach {gens : List (Equiv.Perm (Fin 24))} {x : ℕ} {cert : Array (ℕ × ℕ × ℕ)}
    (h : certOK gens x cert = true) : ∀ i < cert.size, Reach gens x cert[i]!.1 := by
  simp only [certOK, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq, List.all_eq_true,
    List.mem_range, Bool.or_eq_true] at h
  obtain ⟨⟨_, h0⟩, hall⟩ := h
  intro i
  induction i using Nat.strong_induction_on with
  | _ i ih =>
    intro hi
    rcases hall i hi with hi0 | ⟨⟨hp, hg⟩, hv⟩
    · subst hi0; rw [h0]; exact Reach.refl
    · rw [hv]
      apply Reach.step _ (by rw [List.getD_eq_getElem _ _ hg]; exact List.getElem_mem hg)
      exact ih _ hp (by omega)

/-- The values of a certificate. -/
def certValues (cert : Array (ℕ × ℕ × ℕ)) : List ℕ := cert.toList.map (·.1)

theorem reach_of_mem_certValues {gens : List (Equiv.Perm (Fin 24))} {x : ℕ}
    {cert : Array (ℕ × ℕ × ℕ)} (h : certOK gens x cert = true) {y : ℕ}
    (hy : y ∈ certValues cert) : Reach gens x y := by
  simp only [certValues, List.mem_map] at hy
  obtain ⟨e, he, rfl⟩ := hy
  obtain ⟨i, hi, rfl⟩ := Array.mem_iff_getElem.1 (Array.mem_toList_iff.1 he)
  have := certOK_reach h i hi
  rwa [getElem!_pos cert i hi] at this

/-! ## Rule 30 on a ring of 24 cells -/

/-- The Rule 30 local rule `L xor (C or R)` (as `Basic.rule30`). -/
def r30 (L C R : Bool) : Bool := xor L (C || R)

/-- One Rule 30 step on the ring `ℤ/24`: cell `j` reads cells `j - 1, j, j + 1`. -/
def ring30 (x : ℕ) : ℕ :=
  mk24 (fun j => r30 (x.testBit (j - 1 : Fin 24)) (x.testBit j) (x.testBit (j + 1 : Fin 24)))

theorem testBit_ring30 (x : ℕ) (j : Fin 24) : (ring30 x).testBit j =
    r30 (x.testBit (j - 1 : Fin 24)) (x.testBit j) (x.testBit (j + 1 : Fin 24)) :=
  testBit_mk24_fin _ _

theorem ring30_lt (x : ℕ) : ring30 x < 2 ^ 24 := mk24_lt _

/-- `σ` commutes with Rule 30 on every 24-cell pattern. -/
def Commutes (σ : Equiv.Perm (Fin 24)) : Prop := ∀ x < 2 ^ 24, pmask σ (ring30 x) = ring30 (pmask σ x)

/-- The rotation of the ring by `k` cells. -/
abbrev rot (k : Fin 24) : Equiv.Perm (Fin 24) := Equiv.addRight k

theorem rot_add (a b : Fin 24) : rot a * rot b = rot (a + b) := by
  ext i; simp [Equiv.Perm.mul_apply, add_assoc, add_comm a b]

/-- **Every rotation commutes with Rule 30.** -/
theorem rot_commutes (k : Fin 24) : Commutes (rot k) := by
  intro x _
  apply eq_of_cells (pmask_lt _ _) (ring30_lt _)
  intro j
  rw [testBit_pmask, testBit_ring30, testBit_ring30, testBit_pmask, testBit_pmask, testBit_pmask]
  simp only [Equiv.coe_addRight, Equiv.addRight_symm, Equiv.coe_addRight]
  congr 3 <;> abel

/-- The cells next to `σ (j + 1)` (used in `commutes_iff_rot`). -/
theorem commutes_neighbour {σ : Equiv.Perm (Fin 24)} (h : Commutes σ) (j : Fin 24) :
    σ (j + 1) - 1 = σ j ∨ σ (j + 1) + 1 = σ j := by
  have hx : (2 : ℕ) ^ (j : ℕ) < 2 ^ 24 := Nat.pow_lt_pow_right (by norm_num) j.isLt
  have e := congrArg (fun z => z.testBit (σ (j + 1) : ℕ)) (h _ hx)
  simp only at e
  rw [testBit_pmask_apply, testBit_ring30, testBit_ring30, testBit_pmask, testBit_pmask,
    testBit_pmask, Equiv.symm_apply_apply, add_sub_cancel_right] at e
  simp only [Nat.testBit_two_pow, Fin.val_inj] at e
  by_cases hA : σ.symm (σ (j + 1) - 1) = j
  · left; have := congrArg σ hA; simpa using this
  by_cases hB : σ.symm (σ (j + 1) + 1) = j
  · right; have := congrArg σ hB; simpa using this
  exfalso
  have h1 : (j = j + 1) = False := by simp
  have h2 : (j = j + 1 + 1) = False := by simp [add_assoc]
  have h3 : (j = σ.symm (σ (j + 1) - 1)) = False := by simp only [eq_iff_iff, iff_false]; exact fun hh => hA hh.symm
  have h4 : (j = σ.symm (σ (j + 1) + 1)) = False := by simp only [eq_iff_iff, iff_false]; exact fun hh => hB hh.symm
  simp [h1, h2, h3, h4, r30] at e

theorem commutes_step {σ : Equiv.Perm (Fin 24)} (h : Commutes σ) (j : Fin 24) :
    σ (j + 1) = σ j + 1 ∨ σ (j + 1) = σ j - 1 := by
  rcases commutes_neighbour h j with e | e
  · left; rw [← e]; abel
  · right; rw [← e]; abel

theorem commutes_step_up {σ : Equiv.Perm (Fin 24)} (h : Commutes σ) {j : Fin 24}
    (hj : σ (j + 1) = σ j + 1) : σ (j + 1 + 1) = σ (j + 1) + 1 := by
  rcases commutes_step h (j + 1) with e | e
  · exact e
  · exfalso
    rw [hj, add_sub_cancel_right] at e
    have := σ.injective e
    rw [add_assoc] at this
    exact absurd (add_eq_left.1 this) (by decide)

theorem commutes_step_down {σ : Equiv.Perm (Fin 24)} (h : Commutes σ) {j : Fin 24}
    (hj : σ (j + 1) = σ j - 1) : σ (j + 1 + 1) = σ (j + 1) - 1 := by
  rcases commutes_step h (j + 1) with e | e
  · exfalso
    rw [hj, sub_add_cancel] at e
    have := σ.injective e
    rw [add_assoc] at this
    exact absurd (add_eq_left.1 this) (by decide)
  · exact e

/-- `pmask` only sees the inverse permutation. -/
theorem pmask_congr {σ τ : Equiv.Perm (Fin 24)} (h : ∀ j, σ.symm j = τ.symm j) (x : ℕ) :
    pmask σ x = pmask τ x := by
  unfold pmask; congr 1; funext j; rw [h]

/-- The reflection `i ↦ c - i` of the ring. -/
def reflect (c : Fin 24) : Equiv.Perm (Fin 24) :=
  ⟨fun i => c - i, fun i => c - i, fun i => by simp, fun i => by simp⟩

/-- **Rule 30 is chiral**: no reflection of the ring commutes with it (the two-cell pattern
`cells 0, 1` already separates them). -/
theorem reflect_not_commutes : ∀ c : Fin 24,
    pmask (reflect c) (ring30 3) ≠ ring30 (pmask (reflect c) 3) := by
  decide +kernel

open Fin.NatCast in
/-- **Only rotations commute with Rule 30.** A permutation of the 24 cells of the ring commutes
with one Rule 30 step on every pattern exactly when it is a rotation. -/
theorem commutes_iff_rot (σ : Equiv.Perm (Fin 24)) : Commutes σ ↔ ∃ k, σ = rot k := by
  constructor
  · intro h
    rcases commutes_step h 0 with h0 | h0
    · have key : ∀ n : ℕ, σ ((n + 1 : ℕ) : Fin 24) = σ (n : Fin 24) + 1 := by
        intro n
        induction n with
        | zero => simpa using h0
        | succ n ih =>
          have := commutes_step_up h (j := (n : Fin 24)) (by simpa using ih)
          simpa [add_assoc] using this
      have hval : ∀ n : ℕ, σ (n : Fin 24) = σ 0 + (n : Fin 24) := by
        intro n
        induction n with
        | zero => simp
        | succ n ih => rw [key n, ih]; push_cast; abel
      refine ⟨σ 0, Equiv.ext fun i => ?_⟩
      have := hval i.val
      simp only [Fin.cast_val_eq_self] at this
      rw [this]; simp [add_comm]
    · exfalso
      have key : ∀ n : ℕ, σ ((n + 1 : ℕ) : Fin 24) = σ (n : Fin 24) - 1 := by
        intro n
        induction n with
        | zero => simpa using h0
        | succ n ih =>
          have := commutes_step_down h (j := (n : Fin 24)) (by simpa using ih)
          simpa [add_assoc] using this
      have hval : ∀ n : ℕ, σ (n : Fin 24) = σ 0 - (n : Fin 24) := by
        intro n
        induction n with
        | zero => simp
        | succ n ih => rw [key n, ih]; push_cast; abel
      have hσ : ∀ i, σ i = σ 0 - i := by
        intro i; have := hval i.val; simpa using this
      have hsymm : ∀ j, σ.symm j = (reflect (σ 0)).symm j := by
        intro j
        apply σ.injective
        rw [Equiv.apply_symm_apply, hσ]
        show j = σ 0 - (σ 0 - j)
        abel
      apply reflect_not_commutes (σ 0)
      rw [← pmask_congr hsymm, ← pmask_congr hsymm]
      exact h 3 (by norm_num)
  · rintro ⟨k, rfl⟩; exact rot_commutes k

/-- **The transport principle.** A symmetry that commutes with one step carries whole futures:
the `n`-th step of a moved seed is the moved `n`-th step.  This is the only sense in which an orbit
of seeds is an orbit of *dynamically* related patterns. -/
theorem transport_iterate {α : Type*} (F g : α → α) (hc : ∀ x, F (g x) = g (F x)) (n : ℕ)
    (x : α) : F^[n] (g x) = g (F^[n] x) := by
  induction n generalizing x with
  | zero => rfl
  | succ n ih => rw [Function.iterate_succ_apply, Function.iterate_succ_apply, hc, ih]

theorem ring30_iterate_lt (n : ℕ) {x : ℕ} (hx : x < 2 ^ 24) : ring30^[n] x < 2 ^ 24 := by
  cases n with
  | zero => exact hx
  | succ n => rw [Function.iterate_succ_apply']; exact ring30_lt _

/-- Rotations carry Rule 30 futures on the ring. -/
theorem rot_transport (k : Fin 24) (n : ℕ) {x : ℕ} (hx : x < 2 ^ 24) :
    ring30^[n] (pmask (rot k) x) = pmask (rot k) (ring30^[n] x) := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ih,
      rot_commutes k _ (ring30_iterate_lt n hx)]

/-! ## Symmetries shared by the code and by Rule 30 -/

/-- `σ` maps the set of patterns `D` into itself. -/
def PreservesSet (σ : Equiv.Perm (Fin 24)) (D : Set ℕ) : Prop := ∀ x ∈ D, pmask σ x ∈ D

/-- The Golay code laid out on the ring by the labelling `τ`: code coordinate `i` sits at ring
cell `τ i`. -/
def placed (τ : Equiv.Perm (Fin 24)) : Set ℕ := pmask τ '' code

/-- `σ` is a **shared symmetry** under the labelling `τ`: it commutes with Rule 30 on the ring
and it is an automorphism of the laid-out code (an element of the laid-out `M₂₄`). -/
def Shared (τ σ : Equiv.Perm (Fin 24)) : Prop := Commutes σ ∧ PreservesSet σ (placed τ)

theorem placed_one : placed 1 = code := by
  ext x; constructor
  · rintro ⟨c, hc, rfl⟩; rwa [pmask_one (code_lt hc)]
  · intro hx; exact ⟨x, hx, pmask_one (code_lt hx)⟩

theorem preservesSet_placed_iff (τ σ : Equiv.Perm (Fin 24)) :
    PreservesSet σ (placed τ) ↔ PreservesCode (τ.symm * σ * τ) := by
  constructor
  · intro h c hc
    obtain ⟨c', hc', he⟩ := h _ ⟨c, hc, rfl⟩
    rw [pmask_mul, pmask_mul, ← he, pmask_symm_pmask τ (code_lt hc')]
    exact hc'
  · rintro h _ ⟨c, hc, rfl⟩
    refine ⟨pmask (τ.symm * σ * τ) c, h c hc, ?_⟩
    rw [pmask_mul, pmask_mul, pmask_pmask_symm τ (pmask_lt _ _)]

theorem PreservesSet.mul {σ σ' : Equiv.Perm (Fin 24)} {D : Set ℕ} (h : PreservesSet σ D)
    (h' : PreservesSet σ' D) : PreservesSet (σ * σ') D := by
  intro x hx; rw [pmask_mul]; exact h _ (h' _ hx)

/-- Pigeonhole in `ℤ/24`: a set closed under addition that misses `1` has at most 12 elements. -/
theorem card_le_twelve_of_add_closed (S : Finset (Fin 24))
    (hadd : ∀ a ∈ S, ∀ b ∈ S, a + b ∈ S) (h1 : (1 : Fin 24) ∉ S) : S.card ≤ 12 := by
  by_contra hc
  push_neg at hc
  set T := S.image (fun b => 1 - b) with hT
  have hTc : T.card = S.card := Finset.card_image_of_injective _ (fun a b h => by simpa using h)
  have hnd : ¬ Disjoint S T := by
    intro hd
    have := Finset.card_union_of_disjoint hd
    have hle : (S ∪ T).card ≤ 24 := by
      simpa using Finset.card_le_univ (S ∪ T)
    omega
  rw [Finset.not_disjoint_iff] at hnd
  obtain ⟨a, haS, haT⟩ := hnd
  obtain ⟨b, hbS, rfl⟩ := Finset.mem_image.1 haT
  have := hadd _ haS _ hbS
  rw [sub_add_cancel] at this
  exact h1 this

open Classical in
/-- **At most 12 shared symmetries, once the one-cell rotation is excluded.**  If turning the
ring by one cell is not an automorphism of the laid-out code, then at most 12 permutations of the
24 cells are both Rule 30 symmetries and code automorphisms. -/
theorem shared_card_le_of_not_one (τ : Equiv.Perm (Fin 24))
    (h1 : ¬ PreservesSet (rot 1) (placed τ)) :
    (Finset.univ.filter (Shared τ)).card ≤ 12 := by
  set S := Finset.univ.filter (fun k : Fin 24 => PreservesSet (rot k) (placed τ))
  have hS : S.card ≤ 12 := by
    apply card_le_twelve_of_add_closed
    · intro a ha b hb
      simp only [S, Finset.mem_filter, Finset.mem_univ, true_and] at ha hb ⊢
      rw [← rot_add]; exact ha.mul hb
    · simpa [S] using h1
  calc (Finset.univ.filter (Shared τ)).card
      = ((Finset.univ.filter (Shared τ)).image (fun σ => σ 0)).card := by
        rw [Finset.card_image_of_injOn]
        intro σ hσ σ' hσ' he
        simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_setOf_eq] at hσ hσ'
        obtain ⟨k, rfl⟩ := (commutes_iff_rot σ).1 hσ.1
        obtain ⟨k', rfl⟩ := (commutes_iff_rot σ').1 hσ'.1
        simp only [Equiv.coe_addRight, zero_add] at he
        rw [he]
    _ ≤ S.card := by
        apply Finset.card_le_card
        intro k hk
        obtain ⟨σ, hσ, rfl⟩ := Finset.mem_image.1 hk
        simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hσ ⊢
        obtain ⟨k, rfl⟩ := (commutes_iff_rot σ).1 hσ.1
        simpa [S] using hσ.2
    _ ≤ 12 := hS

/-- The shared symmetries are exactly the rotations that preserve the laid-out code. -/
theorem shared_iff (τ σ : Equiv.Perm (Fin 24)) :
    Shared τ σ ↔ ∃ k, σ = rot k ∧ PreservesSet (rot k) (placed τ) := by
  constructor
  · rintro ⟨hc, hp⟩
    obtain ⟨k, rfl⟩ := (commutes_iff_rot σ).1 hc
    exact ⟨k, rfl, hp⟩
  · rintro ⟨k, rfl, hp⟩; exact ⟨rot_commutes k, hp⟩

end GLM.Rule30.Mathieu
