import RequestProject.GLM.Rule30.Compute

/-!
# Round 13: Rule 30 as a chemistry lab

Treat a row as a mixture of two species (black, white), the rule as a reaction acting on every
three-cell neighbourhood at once, and the seed run as one experiment.  Then a chemist would ask:

1. **Is the reaction balanced?**  Of the 8 neighbourhood "reactants", exactly 4 produce black
   (`reaction_table_balanced`), so from a fair-coin row each new cell is again a fair coin.  (The
   full statement, that the fair-coin mixture is an equilibrium of the whole row, is
   `Invariance.lean`, Round 4.)
2. **Is it reversible?**  No: the all-black and all-white rows both react to the all-white row
   (`step_allBlack`, `step_not_injective`).
3. **Is anything conserved?**  A conservation law of range `r` is a weight `f` on the windows of
   `r` consecutive cells, with `f(white…white) = 0`, whose total `Σ_i f(window at i)` stays the
   same from row to row (`rowQty`), the way mass or charge is conserved in a reaction.  Some weights
   are conserved for a trivial reason: if `f` is a *coboundary*, `f(w) = g(tail w) − g(init w)`,
   then its total telescopes to `0` on every finite row (`coboundary_total_zero`,
   `rowQty_of_isCoboundary`).

   **Theorem (`CERT`, `seed_run_no_conservation_law`):** for every range `r ≤ 6`, any weight whose
   total is the same on the rows `0, …, T_r` of the seed run (`T_r = 1, 2, 4, 11, 26, 32`) is a
   coboundary.  So the seed experiment has **no non-trivial conserved quantity of range `≤ 6`**:
   every such quantity is identically `0` on every finite row.

The point for the prize questions: in chemistry, balance laws (stoichiometry) fix the yield.
Problem 2 asks for a yield (frequency of black → 1/2), but the Rule 30 lab has no conserved
quantity of small range that could fix it, so the stoichiometric route is blocked at those ranges.

The certificate is a matrix identity checked by `native_decide`: it writes every window weight as
a coboundary part plus a combination of the conservation equations (`coboundary_of_cert`).
-/

namespace GLM.Rule30

/-! ## The reaction table -/

/-- **The reaction is balanced:** exactly 4 of the 8 neighbourhoods produce black. -/
theorem reaction_table_balanced :
    ((Finset.univ : Finset (Bool × Bool × Bool)).filter
      (fun n => rule30 n.1 n.2.1 n.2.2 = true)).card = 4 := by decide

/-- The all-black row reacts to the all-white row. -/
theorem step_allBlack : step (fun _ => true) = fun _ => false := by
  funext c; rfl

/-- **The reaction is irreversible:** two different rows have the same successor. -/
theorem step_not_injective : ¬ Function.Injective step := by
  intro h
  have : (fun _ : ℤ => true) = fun _ => false :=
    h (by rw [step_allBlack]; funext c; simp [step, rule30])
  exact absurd (congrFun this 0) (by decide)

/-! ## Additive quantities -/

/-- The window of `m` consecutive cells of `x` starting at `i`. -/
def winF (m : ℕ) (x : Config) (i : ℤ) : Fin m → Bool := fun k => x (i + k)

/-- The total of the weight `f` (on windows of `n + 1` cells) over row `t` of the seed run.
Every window meeting the light cone `[-t, t]` is counted. -/
def rowQty (n : ℕ) (f : (Fin (n + 1) → Bool) → ℚ) (t : ℕ) : ℚ :=
  ∑ i ∈ Finset.Ico (-(t : ℤ) - n) ((t : ℤ) + 1), f (winF (n + 1) (evolve seed t) i)

/-- A weight is a *coboundary* if `f(w) = g(tail w) − g(init w)` for some `g` on shorter
windows.  Its totals telescope. -/
def IsCoboundary {n : ℕ} (f : (Fin (n + 1) → Bool) → ℚ) : Prop :=
  ∃ g : (Fin n → Bool) → ℚ, ∀ w, f w = g (Fin.tail w) - g (Fin.init w)

theorem tail_winF (n : ℕ) (x : Config) (i : ℤ) :
    Fin.tail (winF (n + 1) x i) = winF n x (i + 1) := by
  funext k; simp only [Fin.tail, winF, Fin.val_succ]; congr 1; push_cast; ring

theorem init_winF (n : ℕ) (x : Config) (i : ℤ) :
    Fin.init (winF (n + 1) x i) = winF n x i := by
  funext k; simp [Fin.init, winF]

/-- Telescoping. -/
theorem sum_Ico_telescope (G : ℤ → ℚ) (a b : ℤ) (hab : a ≤ b) :
    ∑ i ∈ Finset.Ico a b, (G (i + 1) - G i) = G b - G a := by
  induction b, hab using Int.le_induction with
  | base => simp
  | succ b hb ih =>
    rw [← Finset.insert_Ico_right_eq_Ico_add_one hb, Finset.sum_insert (by simp), ih]
    ring

/-- **A coboundary weight has total `0` on every finite row.** -/
theorem coboundary_total_zero {n : ℕ} {f : (Fin (n + 1) → Bool) → ℚ} (hf : IsCoboundary f)
    (x : Config) (lo hi : ℤ) (hle : lo ≤ hi)
    (hlo : ∀ j, j < lo + n → x j = false) (hhi : ∀ j, hi ≤ j → x j = false) :
    ∑ i ∈ Finset.Ico lo hi, f (winF (n + 1) x i) = 0 := by
  obtain ⟨g, hg⟩ := hf
  simp_rw [hg, tail_winF, init_winF]
  rw [sum_Ico_telescope (fun i => g (winF n x i)) lo hi hle]
  have e1 : winF n x hi = fun _ => false := by
    funext k; exact hhi _ (by omega)
  have e2 : winF n x lo = fun _ => false := by
    funext k; exact hlo _ (by have := k.isLt; omega)
  simp [e1, e2]

/-- Coboundary weights have total `0` on every row of the seed run. -/
theorem rowQty_of_isCoboundary {n : ℕ} {f : (Fin (n + 1) → Bool) → ℚ} (hf : IsCoboundary f)
    (t : ℕ) : rowQty n f t = 0 :=
  coboundary_total_zero hf _ _ _ (by omega)
    (fun j hj => evolve_seed_outside t j (by rw [abs_of_neg (by omega)]; omega))
    (fun j hj => evolve_seed_outside t j (by rw [abs_of_pos (by omega)]; omega))

/-! ## Counting windows -/

/-- The number of windows of row `t` (in the counted range) equal to `w`. -/
def winCount (n t : ℕ) (w : Fin (n + 1) → Bool) : ℕ :=
  ((Finset.Ico (-(t : ℤ) - n) ((t : ℤ) + 1)).filter
    (fun i => winF (n + 1) (evolve seed t) i = w)).card

theorem rowQty_eq_sum_count (n : ℕ) (f : (Fin (n + 1) → Bool) → ℚ) (t : ℕ) :
    rowQty n f t = ∑ w, (winCount n t w : ℚ) * f w := by
  unfold rowQty winCount
  have : ∀ i ∈ Finset.Ico (-(t : ℤ) - n) ((t : ℤ) + 1),
      f (winF (n + 1) (evolve seed t) i) =
        ∑ w, if winF (n + 1) (evolve seed t) i = w then f w else 0 := by
    intro i _; simp
  rw [Finset.sum_congr rfl this, Finset.sum_comm]
  refine Finset.sum_congr rfl fun w _ => ?_
  rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]

/-- A cell of the seed run through the verified bit-parallel step. -/
def cellFast (t : ℕ) (c : ℤ) : Bool :=
  if c < -(t : ℤ) then false else (rowStep^[t] 1).testBit (c + t).toNat

theorem evolve_seed_eq_cellFast (t : ℕ) (c : ℤ) : evolve seed t c = cellFast t c := by
  unfold cellFast
  split_ifs with h
  · exact evolve_seed_outside t c (by rw [abs_of_neg (by omega)]; omega)
  · rw [testBit_rowStep_iterate 0 1 t (c + t).toNat, ← seed_eq_maskConfig]
    congr 1; omega

/-- The computable window count. -/
def winCountFast (n t : ℕ) (w : Fin (n + 1) → Bool) : ℕ :=
  ((Finset.Ico (-(t : ℤ) - n) ((t : ℤ) + 1)).filter
    (fun i => (fun k : Fin (n + 1) => cellFast t (i + k)) = w)).card

theorem winCount_eq_fast (n t : ℕ) (w : Fin (n + 1) → Bool) :
    winCount n t w = winCountFast n t w := by
  unfold winCount winCountFast winF
  simp_rw [evolve_seed_eq_cellFast]

/-! ## The certificate -/

/-- The index of a window (its cells as binary digits). -/
def winIdx {m : ℕ} (v : Fin m → Bool) : ℕ := ∑ k : Fin m, (v k).toNat * 2 ^ (k : ℕ)

/-- A rational from a numerator/denominator pair. -/
def qOf (p : ℤ × ℕ) : ℚ := (p.1 : ℚ) / p.2

/-- Read a table entry. -/
def tab (L : List (List (ℤ × ℕ))) (a b : ℕ) : ℚ := qOf ((L.getD a []).getD b (0, 1))

/-- The certificate identity: for all windows `w, w'`,
`δ(w, w') = B(tail w, w') − B(init w, w') + Σ_t C(w, t)·(count_{t+1}(w') − count_0(w')) + C₀(w)·[w' = 0]`. -/
def certOK (n T : ℕ) (Bt Ct : List (List (ℤ × ℕ))) (C0 : List (ℤ × ℕ)) : Bool :=
  decide (∀ w w' : Fin (n + 1) → Bool,
    (if w = w' then (1 : ℚ) else 0) =
      tab Bt (winIdx (Fin.tail w)) (winIdx w') - tab Bt (winIdx (Fin.init w)) (winIdx w') +
      (∑ t ∈ Finset.range T, tab Ct (winIdx w) t *
        ((winCountFast n (t + 1) w' : ℚ) - winCountFast n 0 w')) +
      qOf (C0.getD (winIdx w) (0, 1)) * (if w' = (fun _ => false) then 1 else 0))

/-- **A certificate turns the conservation equations into a coboundary.** -/
theorem coboundary_of_cert {n T : ℕ} {Bt Ct : List (List (ℤ × ℕ))} {C0 : List (ℤ × ℕ)}
    (hc : certOK n T Bt Ct C0 = true) (f : (Fin (n + 1) → Bool) → ℚ)
    (h0 : f (fun _ => false) = 0) (hcons : ∀ t ≤ T, rowQty n f t = rowQty n f 0) :
    IsCoboundary f := by
  have hid := of_decide_eq_true hc
  refine ⟨fun g => ∑ w', tab Bt (winIdx g) (winIdx w') * f w', fun w => ?_⟩
  have heq : ∀ t ∈ Finset.range T,
      ∑ w', ((winCountFast n (t + 1) w' : ℚ) - winCountFast n 0 w') * f w' = 0 := by
    intro t ht
    have := hcons (t + 1) (by simp at ht; omega)
    rw [rowQty_eq_sum_count, rowQty_eq_sum_count] at this
    simp_rw [sub_mul, Finset.sum_sub_distrib, ← winCount_eq_fast, this, sub_self]
  set a : (Fin (n + 1) → Bool) → ℚ := fun w' => tab Bt (winIdx (Fin.tail w)) (winIdx w')
  set b : (Fin (n + 1) → Bool) → ℚ := fun w' => tab Bt (winIdx (Fin.init w)) (winIdx w')
  set c : ℕ → ℚ := fun t => tab Ct (winIdx w) t
  set A : ℕ → (Fin (n + 1) → Bool) → ℚ := fun t w' =>
    (winCountFast n (t + 1) w' : ℚ) - winCountFast n 0 w'
  set z : ℚ := qOf (C0.getD (winIdx w) (0, 1))
  have h1 : ∑ w', (∑ t ∈ Finset.range T, c t * A t w') * f w' =
      ∑ t ∈ Finset.range T, c t * ∑ w', A t w' * f w' := by
    simp_rw [Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun t _ => Finset.sum_congr rfl fun w' _ => ?_
    ring
  have h2 : ∑ w', (z * if w' = (fun _ => false) then (1 : ℚ) else 0) * f w' =
      z * f (fun _ => false) := by
    simp [mul_ite, ite_mul]
  have h3 : ∑ t ∈ Finset.range T, c t * ∑ w', A t w' * f w' = 0 :=
    Finset.sum_eq_zero fun t ht => by simp only [A]; rw [heq t ht, mul_zero]
  calc f w = ∑ w', (if w = w' then (1 : ℚ) else 0) * f w' := by simp
    _ = ∑ w', ((a w' - b w' + ∑ t ∈ Finset.range T, c t * A t w') +
          z * (if w' = (fun _ => false) then 1 else 0)) * f w' := by
        refine Finset.sum_congr rfl fun w' _ => ?_
        rw [hid w w']
    _ = (∑ w', a w' * f w') - (∑ w', b w' * f w') +
          ∑ w', (∑ t ∈ Finset.range T, c t * A t w') * f w' +
          ∑ w', (z * if w' = (fun _ => false) then (1 : ℚ) else 0) * f w' := by
        simp only [add_mul, sub_mul, Finset.sum_add_distrib, Finset.sum_sub_distrib]
    _ = _ := by rw [h1, h2, h3, h0]; simp [a, b]

