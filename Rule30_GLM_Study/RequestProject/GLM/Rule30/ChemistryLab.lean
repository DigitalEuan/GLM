/-- The number of rows used for range `n + 1`. -/
def chemRows (n : ℕ) : ℕ := [1, 2, 4, 11, 26, 32].getD n 0

/-- **No conservation law of range `≤ 6` in the seed experiment (`CERT`).** For a weight `f` on
windows of `n + 1 ≤ 6` cells with `f(white…white) = 0`: if its total is the same on the rows
`0, …, chemRows n` of the seed run, then `f` is a coboundary — so its total is `0` on every finite
row (`coboundary_total_zero`) and on every row of the run (`rowQty_of_isCoboundary`). -/
theorem seed_run_no_conservation_law (n : ℕ) (hn : n ≤ 5) (f : (Fin (n + 1) → Bool) → ℚ)
    (h0 : f (fun _ => false) = 0) (hcons : ∀ t ≤ chemRows n, rowQty n f t = rowQty n f 0) :
    IsCoboundary f := by
  interval_cases n
  · exact coboundary_of_cert chemCert1 f h0 hcons
  · exact coboundary_of_cert chemCert2 f h0 hcons
  · exact coboundary_of_cert chemCert3 f h0 hcons
  · exact coboundary_of_cert chemCert4 f h0 hcons
  · exact coboundary_of_cert chemCert5 f h0 hcons
  · exact coboundary_of_cert chemCert6 f h0 hcons

/-- **Corollary:** a weight of range `≤ 6` whose total is constant along the seed run has total
`0` on every row of the run. -/
theorem seed_run_conserved_quantity_vanishes (n : ℕ) (hn : n ≤ 5) (f : (Fin (n + 1) → Bool) → ℚ)
    (h0 : f (fun _ => false) = 0) (hcons : ∀ t, rowQty n f t = rowQty n f 0) (t : ℕ) :
    rowQty n f t = 0 :=
  rowQty_of_isCoboundary (seed_run_no_conservation_law n hn f h0 fun t _ => hcons t) t

