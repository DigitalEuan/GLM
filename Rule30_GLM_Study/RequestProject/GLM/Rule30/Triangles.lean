module

public import RequestProject.GLM.Rule30.WhiteDiagonals
public import RequestProject.GLM.Rule30.Diagonals

/-!
# Round 48: white triangles, the two line directions, and the right-edge bands

The owner's observations (Round 48 prompt):

1. *a line heading left and down is always continuous; a line heading right and down only
   appears now and then, and ends;*
2. *larger white (upside-down) triangles appear more on the right side and are not seen near the
   left edge at all; they look like operators;*
3. *the print-out seems to come from the right side in and down, in bands, each band generating
   the triangles of the next.*

This file turns each observation into exact statements about Rule 30.

## 1. The triangle law (every row, not only the seed)

* `white_shrinks`, `white_triangle` : a white run `[a, b]` is followed by the white run
  `[a + 1, b − 1]`, and after `k` steps by `[a + k, b − k]`.  **A white run of length `L` is the top
  row of a white triangle of height `⌈L/2⌉`**, whatever the rest of the row is.
* `white_run_black_borders`, `maximal_white_triangle` : if the run is bounded by black cells, the
  triangle is outlined in black on both sides in every row.  Its left side is a black line heading
  right and down, its right side a black line heading left and down.
* `odd_tip_white` : a single white cell between two black cells stays white.  So triangles with an
  odd top end in a white tip, and triangles with an even top close with two black cells.
* `white_run_parent`, `black_run_child` : **where triangles come from.**  Above a white run `[a, b]`
  the cells `[a − 1, b − 1]` all have the same colour.  Either they are all white (the run is the
  inside of a larger triangle) or they are all black (the run is the top of a new triangle, born
  from a black run in the row before).  Conversely a black run `[a, b]` is followed by the white run
  `[a + 1, b]`.  So every white triangle is generated by a black run in the previous row,
  at least as long as the triangle's top.

## 2. The two line directions (every row)

* `rightDown_continues_iff` : a black cell continues a black line one step right and down
  **iff both** cells to its right are white.  A right-down black line can only run along the
  left side of a white region, and it ends when the white region ends.  These are the left
  sides of white triangles.
* `leftDown_continues_iff` : a black cell continues a black line one step left and down **iff the
  single** cell two to its left is white.  It does not matter what is directly to its left.
* `column_from_right` : the rule can be solved for its left input.  The two columns `c`, `c + 1`
  (all times) determine column `c − 1`, so the whole pattern can be printed **from the right side
  in**, one column at a time.

## 3. Which lines never end (the seed pattern)

* `ldiag_eventuallyBlack_iff` : for `D ≥ 2`, the left-down line `D` is eventually all black **iff**
  the line `D − 2` is eventually all white.
* `ldiag_infinitely_many_black` : **infinitely many left-down black lines never end** (lines `0`,
  `1` and `w + 2` for every eventually white left diagonal `w`; the certified list gives
  `0, 1, 4, 9, 30, 401, 53209, 58288, 87868, …`).
* `rdiag_black_segment_short`, `rdiag_not_eventuallyBlack` : the right-down black line `D` cells
  inside the right edge breaks within every `2 ^ D` consecutive steps.  **Apart from the right edge
  itself, every right-down black line ends.**

## 4. The right edge prints in bands (the seed pattern)

* `right_band_copy` : the strip of the first `k` right diagonals repeats with period `2 ^ k`.  The
  rows `[n · 2^k, (n+1) · 2^k)` near the right edge are a copy of the rows `[0, 2^k)`.
* `right_edge_white_run`, `right_edge_triangle` : at every row `t = n · 2 ^ k` the `k` cells just
  inside the right edge are white.  So a white triangle of height `⌈k/2⌉` hangs from the right
  edge at the start of every band of length `2 ^ k` (the size at row `t` is at least the number
  of times `2` divides `t`).
* `arbitrarily_large_right_triangles` : so white triangles of every size occur one cell inside
  the right edge.

The left side behaves the other way: `TrianglesData.lean` certifies that the first `20000` left
diagonals contain no white run longer than `16` at any time from `26834` on, and the first `400`
none longer than `15` at any time.

All results in this file use only the standard axioms.
-/

@[expose] public section

namespace GLM.Rule30

/-! ## Two evolution helpers -/

theorem evolve_add_tri (x : Config) (m n : ℕ) : evolve x (m + n) = evolve (evolve x m) n := by
  induction n with
  | zero => rfl
  | succ n ih => rw [← Nat.add_assoc, evolve, evolve, ih]

theorem step_apply (x : Config) (c : ℤ) : step x c = xor (x (c - 1)) (x c || x (c + 1)) := rfl

/-! ## 1. The triangle law -/

/-- **A white run shrinks by one cell on each side.** -/
theorem white_shrinks (x : Config) (a b : ℤ) (hw : ∀ c, a ≤ c → c ≤ b → x c = false) :
    ∀ c, a + 1 ≤ c → c ≤ b - 1 → step x c = false := by
  intro c h1 h2
  rw [step_apply, hw (c - 1) (by omega) (by omega), hw c (by omega) (by omega),
    hw (c + 1) (by omega) (by omega)]
  rfl

/-- **The white triangle.** Below a white run `[a, b]`, row `k` is white on `[a + k, b − k]`. -/
theorem white_triangle (x : Config) (a b : ℤ) (hw : ∀ c, a ≤ c → c ≤ b → x c = false) (k : ℕ) :
    ∀ c, a + k ≤ c → c ≤ b - k → evolve x k c = false := by
  induction k generalizing x a b with
  | zero => intro c h1 h2; exact hw c (by simpa using h1) (by simpa using h2)
  | succ k ih =>
    intro c h1 h2
    rw [evolve_succ']
    exact ih (step x) (a + 1) (b - 1) (white_shrinks x a b hw) c (by push_cast at h1; omega)
      (by push_cast at h2; omega)

/-- **The black outline.** A white run of length at least `2` between two black cells is followed
by black cells at its two old end points. -/
theorem white_run_black_borders (x : Config) (a b : ℤ) (hab : a < b)
    (hw : ∀ c, a ≤ c → c ≤ b → x c = false) (hl : x (a - 1) = true) (hr : x (b + 1) = true) :
    step x a = true ∧ step x b = true := by
  constructor
  · rw [step_apply, hl, hw a le_rfl hab.le, hw (a + 1) (by omega) (by omega)]; rfl
  · rw [step_apply, hw (b - 1) (by omega) (by omega), hw b hab.le le_rfl, hr]; rfl

/-- **The outlined triangle.** Below a maximal white run `[a, b]` (black at `a − 1` and `b + 1`),
for every `k` with `2k ≤ b − a`, row `k` is white exactly on `[a + k, b − k]`, with black cells at
`a + k − 1` and `b − k + 1`. -/
theorem maximal_white_triangle (x : Config) (a b : ℤ) (hw : ∀ c, a ≤ c → c ≤ b → x c = false)
    (hl : x (a - 1) = true) (hr : x (b + 1) = true) (k : ℕ) (hk : 2 * (k : ℤ) ≤ b - a) :
    (∀ c, a + k ≤ c → c ≤ b - k → evolve x k c = false) ∧
      evolve x k (a + k - 1) = true ∧ evolve x k (b - k + 1) = true := by
  induction k with
  | zero => exact ⟨fun c h1 h2 => hw c (by simpa using h1) (by simpa using h2),
      by simpa using hl, by simpa using hr⟩
  | succ k ih =>
    obtain ⟨hw', hl', hr'⟩ := ih (by push_cast at hk; omega)
    refine ⟨white_triangle x a b hw (k + 1), ?_⟩
    have hb := white_run_black_borders (evolve x k) (a + k) (b - k) (by push_cast at hk; omega)
      hw' hl' hr'
    rw [evolve]
    push_cast
    constructor
    · convert hb.1 using 2; ring
    · convert hb.2 using 2; ring

/-- **The odd tip.** A single white cell between two black cells stays white. -/
theorem odd_tip_white (x : Config) (c : ℤ) (hl : x (c - 1) = true) (hc : x c = false)
    (hr : x (c + 1) = true) : step x c = false := by
  rw [step_apply, hl, hc, hr]; rfl

/-- **The even tip.** Two white cells between black cells become two black cells. -/
theorem even_tip_closes (x : Config) (c : ℤ) (hl : x (c - 1) = true) (h0 : x c = false)
    (h1 : x (c + 1) = false) (hr : x (c + 2) = true) :
    step x c = true ∧ step x (c + 1) = true := by
  have := white_run_black_borders x c (c + 1) (by omega)
    (fun d h1' h2' => by
      rcases (show d = c ∨ d = c + 1 by omega) with rfl | rfl
      · exact h0
      · exact h1) hl (by simpa [add_assoc] using hr)
  exact this

/-- **Black runs give birth to white runs.** Below a black run `[a, b]` the row is white on
`[a + 1, b]`. -/
theorem black_run_child (x : Config) (a b : ℤ) (hb : ∀ c, a ≤ c → c ≤ b → x c = true) :
    ∀ c, a + 1 ≤ c → c ≤ b → step x c = false := by
  intro c h1 h2
  rw [step_apply, hb (c - 1) (by omega) (by omega), hb c (by omega) (by omega)]
  rfl

/-- The step core of `white_run_parent`: going leftwards from `b`, each cell above the white run
equals `v = x b ∨ x (b + 1)`. -/
theorem white_run_parent_aux (x : Config) (a b : ℤ)
    (hw : ∀ c, a ≤ c → c ≤ b → step x c = false) (j : ℕ) (hj : (j : ℤ) ≤ b - a) :
    x (b - 1 - j) = (x b || x (b + 1)) ∧ (x (b - j) = true → (x b || x (b + 1)) = true) := by
  induction j with
  | zero =>
    have h := hw b (by simpa using hj) le_rfl
    rw [step_apply] at h
    simp only [Nat.cast_zero, sub_zero]
    refine ⟨?_, fun h' => by simp [h']⟩
    revert h; cases x (b - 1) <;> cases x b <;> cases x (b + 1) <;> simp
  | succ j ih =>
    obtain ⟨h1, h2⟩ := ih (by push_cast at hj; omega)
    have h := hw (b - 1 - j) (by push_cast at hj; omega) (by omega)
    rw [step_apply] at h
    have e1 : b - 1 - ((j + 1 : ℕ) : ℤ) = b - 1 - j - 1 := by push_cast; ring
    have e2 : b - ((j + 1 : ℕ) : ℤ) = b - 1 - j := by push_cast; ring
    have e3 : b - 1 - (j : ℤ) + 1 = b - j := by ring
    rw [e3] at h
    rw [e1, e2]
    refine ⟨?_, fun h' => by rw [← h1]; exact h'⟩
    revert h h1 h2
    cases x (b - 1 - j - 1) <;> cases x (b - 1 - j) <;> cases x (b - j) <;>
      cases (x b || x (b + 1)) <;> simp

/-- **Where triangles come from.** Above a white run `[a, b]` of row `t + 1`, the cells
`[a − 1, b − 1]` of row `t` have one colour.  Either all of them are black (the run is the top of a
new triangle, born from that black run), or all of `[a − 1, b + 1]` are white (the run continues a
larger triangle). -/
theorem white_run_parent (x : Config) (a b : ℤ) (hab : a ≤ b)
    (hw : ∀ c, a ≤ c → c ≤ b → step x c = false) :
    (∀ c, a - 1 ≤ c → c ≤ b - 1 → x c = true) ∨ (∀ c, a - 1 ≤ c → c ≤ b + 1 → x c = false) := by
  have key : ∀ c, a - 1 ≤ c → c ≤ b - 1 → x c = (x b || x (b + 1)) := by
    intro c h1 h2
    obtain ⟨j, hj⟩ : ∃ j : ℕ, (j : ℤ) = b - 1 - c := ⟨(b - 1 - c).toNat, by omega⟩
    have := (white_run_parent_aux x a b hw j (by omega)).1
    rwa [show b - 1 - (j : ℤ) = c by omega] at this
  cases hv : (x b || x (b + 1))
  · right
    have hb : x b = false := by revert hv; cases x b <;> simp
    have hb1 : x (b + 1) = false := by revert hv; cases x (b + 1) <;> simp
    intro c h1 h2
    rcases (show c ≤ b - 1 ∨ c = b ∨ c = b + 1 by omega) with h | rfl | rfl
    · rw [key c h1 h, hv]
    · exact hb
    · exact hb1
  · left
    intro c h1 h2
    rw [key c h1 h2, hv]

/-! ## 2. The two line directions -/

/-- **Right-down lines need white on their right.** A black cell is followed by a black cell one
step right and down iff the two cells to its right are both white. -/
theorem rightDown_continues_iff (x : Config) (c : ℤ) (hc : x c = true) :
    step x (c + 1) = true ↔ x (c + 1) = false ∧ x (c + 2) = false := by
  rw [step_apply, show c + 1 - 1 = c by ring, hc, show c + 1 + 1 = c + 2 by ring]
  cases x (c + 1) <;> cases x (c + 2) <;> simp

/-- **Left-down lines need only one white cell.** A black cell is followed by a black cell one
step left and down iff the cell two to its left is white. -/
theorem leftDown_continues_iff (x : Config) (c : ℤ) (hc : x c = true) :
    step x (c - 1) = true ↔ x (c - 2) = false := by
  rw [step_apply, show c - 1 - 1 = c - 2 by ring, show c - 1 + 1 = c by ring, hc]
  cases x (c - 2) <;> simp

/-- **Printing from the right side in.** Column `c − 1` is determined by columns `c` and `c + 1`:
`a(t)(c − 1) = a(t + 1)(c) xor (a(t)(c) ∨ a(t)(c + 1))`. -/
theorem column_from_right (x : Config) (t : ℕ) (c : ℤ) :
    evolve x t (c - 1) = xor (evolve x (t + 1) c) (evolve x t c || evolve x t (c + 1)) := by
  rw [evolve_succ]
  unfold rule30
  cases evolve x t (c - 1) <;> cases (evolve x t c || evolve x t (c + 1)) <;> rfl

/-! ## 3. Which lines never end -/

/-- `s` is eventually black (eventually `true`). -/
def EventuallyBlack (s : ℕ → Bool) : Prop := ∃ T, ∀ t ≥ T, s t = true

/-- **Infinite left-down lines.** For `D ≥ 2` the left diagonal `D` is eventually all black iff the
left diagonal `D − 2` is eventually all white. -/
theorem ldiag_eventuallyBlack_iff (D : ℕ) :
    EventuallyBlack (ldiag ((D : ℤ) + 2)) ↔ EventuallyWhite (ldiag D) := by
  constructor
  · rintro ⟨T, hT⟩
    refine ⟨T, fun t ht => ?_⟩
    have h1 := hT (t + 1) (by omega)
    have h2 := hT t ht
    rw [ldiag_succ, show (D : ℤ) + 2 - 2 = D by ring, h2] at h1
    revert h1; cases ldiag D t <;> simp
  · rintro ⟨T, hT⟩
    have hnw : ¬ EventuallyWhite (ldiag ((D + 1 : ℕ) : ℤ)) := by
      intro h
      exact ldiag_no_two_consecutive_white D ⟨⟨T, hT⟩, h⟩
    obtain ⟨t₀, ht₀, hb⟩ : ∃ t₀ ≥ T, ldiag ((D + 1 : ℕ) : ℤ) t₀ = true := by
      by_contra hcon
      push_neg at hcon
      exact hnw ⟨T, fun t ht => by simpa using hcon t ht⟩
    refine ⟨t₀ + 1, fun t ht => ?_⟩
    obtain ⟨n, rfl⟩ := Nat.exists_eq_add_of_le ht
    induction n with
    | zero =>
      rw [ldiag_succ, show (D : ℤ) + 2 - 2 = D by ring, hT t₀ ht₀,
        show (D : ℤ) + 2 - 1 = ((D + 1 : ℕ) : ℤ) by push_cast; ring, hb]
      rfl
    | succ n ih =>
      rw [show t₀ + 1 + (n + 1) = (t₀ + 1 + n) + 1 by ring, ldiag_succ,
        show (D : ℤ) + 2 - 2 = D by ring, hT _ (by omega), ih (by omega)]
      simp

/-- Left diagonal `1` is black at every time `t ≥ 1`. -/
theorem ldiag_one_black (t : ℕ) : ldiag 1 (t + 1) = true := by
  rw [ldiag_succ, ldiag_neg (by norm_num), show (1 : ℤ) - 1 = 0 by ring, ldiag_zero]
  rfl

/-- **Infinitely many left-down black lines never end.** -/
theorem ldiag_infinitely_many_black : ∀ D₀ : ℕ, ∃ D ≥ D₀, EventuallyBlack (ldiag D) := by
  intro D₀
  obtain ⟨w, hw, hwh⟩ := ldiag_infinitely_many_white D₀
  refine ⟨w + 2, by omega, ?_⟩
  have := (ldiag_eventuallyBlack_iff w).2 hwh
  simpa using this

/-- The two edge lines `0` and `1` are eventually black. -/
theorem ldiag_zero_one_black : EventuallyBlack (ldiag 0) ∧ EventuallyBlack (ldiag 1) :=
  ⟨⟨0, fun t _ => ldiag_zero t⟩, ⟨1, fun t ht => by
    obtain ⟨n, rfl⟩ := Nat.exists_eq_add_of_le ht
    rw [add_comm]; exact ldiag_one_black n⟩⟩

/-- Right diagonal `D ≥ 1` is white at every multiple of `2 ^ D`. -/
theorem rdiag_white_at_multiple (D : ℕ) (hD : 1 ≤ D) (n : ℕ) : rdiag D (n * 2 ^ D) = false := by
  rw [rdiag_mod, Nat.mul_mod_left, rdiag_zero]
  simp; omega

/-- **Right-down lines break.** For `D ≥ 1`, the right diagonal `D` is not black at `2 ^ D`
consecutive times. -/
theorem rdiag_black_segment_short (D : ℕ) (hD : 1 ≤ D) (t : ℕ) :
    ∃ i < 2 ^ D, rdiag D (t + i) = false := by
  have hpos : 0 < 2 ^ D := by positivity
  refine ⟨(2 ^ D - t % 2 ^ D) % 2 ^ D, Nat.mod_lt _ hpos, ?_⟩
  have hdvd : 2 ^ D ∣ t + (2 ^ D - t % 2 ^ D) % 2 ^ D := by
    rw [Nat.dvd_iff_mod_eq_zero, Nat.add_mod, Nat.mod_mod]
    have := Nat.mod_lt t hpos
    rcases Nat.eq_zero_or_pos (t % 2 ^ D) with h | h
    · rw [h]; simp
    · rw [Nat.mod_eq_of_lt (by omega : 2 ^ D - t % 2 ^ D < 2 ^ D),
        show t % 2 ^ D + (2 ^ D - t % 2 ^ D) = 2 ^ D by omega, Nat.mod_self]
  obtain ⟨n, hn⟩ := hdvd
  rw [hn, mul_comm]
  exact rdiag_white_at_multiple D hD n

/-- **Apart from the right edge, no right-down black line goes on for ever.** -/
theorem rdiag_not_eventuallyBlack (D : ℕ) (hD : 1 ≤ D) : ¬ EventuallyBlack (rdiag D) := by
  rintro ⟨T, hT⟩
  obtain ⟨i, -, hi⟩ := rdiag_black_segment_short D hD T
  rw [hT (T + i) (by omega)] at hi
  exact Bool.noConfusion hi

/-- The right edge itself is a right-down black line that never ends. -/
theorem rdiag_zero_black (t : ℕ) : rdiag 0 t = true := by
  induction t with
  | zero => rw [rdiag_zero]; rfl
  | succ t ih =>
    rw [rdiag_succ, ih, rdiag_neg (by norm_num), rdiag_neg (by norm_num)]
    rfl

/-! ## 4. The right edge prints in bands -/

/-- **The bands.** The strip of the first `k` right diagonals repeats with period `2 ^ k`. -/
theorem right_band_copy (k D : ℕ) (hD : D ≤ k) (s n : ℕ) : rdiag D (n * 2 ^ k + s) = rdiag D s := by
  have hdvd : 2 ^ D ∣ 2 ^ k := pow_dvd_pow 2 hD
  obtain ⟨m, hm⟩ := hdvd
  rw [hm, show n * (2 ^ D * m) + s = s + (n * m) * 2 ^ D by ring]
  exact periodic_nat_mul (rdiag_periodic D) _ _

/-- **A white run at the start of every band.** At every row `t = n · 2 ^ k`, the `k` cells just
inside the right edge are white. -/
theorem right_edge_white_run (k n : ℕ) (D : ℕ) (hD1 : 1 ≤ D) (hDk : D ≤ k) :
    evolve seed (n * 2 ^ k) ((n * 2 ^ k : ℕ) - (D : ℤ)) = false := by
  have := right_band_copy k D hDk 0 n
  rw [add_zero, rdiag_zero] at this
  have h : rdiag D (n * 2 ^ k) = false := by rw [this]; simp; omega
  exact h

/-- **The triangle hanging from the right edge.** Below row `t = n · 2 ^ k`, row `t + j` is white
on the cells `t − k + j, …, t − 1 − j`. -/
theorem right_edge_triangle (k n j : ℕ) :
    ∀ c : ℤ, ((n * 2 ^ k : ℕ) : ℤ) - k + j ≤ c → c ≤ ((n * 2 ^ k : ℕ) : ℤ) - 1 - j →
      evolve seed (n * 2 ^ k + j) c = false := by
  rw [evolve_add_tri]
  apply white_triangle
  intro c h1 h2
  obtain ⟨D, hD⟩ : ∃ D : ℕ, (D : ℤ) = ((n * 2 ^ k : ℕ) : ℤ) - c := ⟨(((n * 2 ^ k : ℕ) : ℤ) - c).toNat,
    by omega⟩
  have := right_edge_white_run k n D (by omega) (by omega)
  rwa [show ((n * 2 ^ k : ℕ) : ℤ) - (D : ℤ) = c by omega] at this

/-- **White triangles of every size one cell inside the right edge.** For every `L` there is a row
`t` whose cells `t − L, …, t − 1` are white (and the cell `t`, the right edge, is black). -/
theorem arbitrarily_large_right_triangles (L : ℕ) :
    ∃ t : ℕ, (∀ c : ℤ, (t : ℤ) - L ≤ c → c ≤ (t : ℤ) - 1 → evolve seed t c = false) ∧
      evolve seed t t = true := by
  refine ⟨1 * 2 ^ L, fun c h1 h2 => ?_, ?_⟩
  · have := right_edge_triangle L 1 0 c (by simpa using h1) (by simpa using h2)
    simpa using this
  · have := rdiag_zero_black (1 * 2 ^ L)
    unfold rdiag at this
    simpa using this

end GLM.Rule30
