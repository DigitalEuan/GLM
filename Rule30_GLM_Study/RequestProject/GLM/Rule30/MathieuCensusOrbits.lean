patterns. -/
theorem sizes_sum : ∀ k ≤ 12, (censusSizes k).sum = Nat.choose 24 k := by decide

/-! ## Complements -/

/-- The complement of a pattern. -/
def compl24 (y : ℕ) : ℕ := y ^^^ (2 ^ 24 - 1)

theorem pmask_ones (g : Equiv.Perm (Fin 24)) : pmask g (2 ^ 24 - 1) = 2 ^ 24 - 1 := by
  apply eq_of_cells (pmask_lt _ _) (by norm_num)
  intro i
  rw [testBit_pmask, Nat.testBit_two_pow_sub_one, Nat.testBit_two_pow_sub_one]
  simp

theorem pmask_compl (g : Equiv.Perm (Fin 24)) (y : ℕ) : pmask g (compl24 y) = compl24 (pmask g y) := by
  rw [compl24, compl24, pmask_xor, pmask_ones]

theorem compl24_lt {y : ℕ} (hy : y < 2 ^ 24) : compl24 y < 2 ^ 24 :=
  Nat.xor_lt_two_pow hy (by norm_num)

theorem compl24_compl24 (y : ℕ) : compl24 (compl24 y) = y := by
  rw [compl24, compl24, Nat.xor_assoc, Nat.xor_self, Nat.xor_zero]

theorem weight_compl24 (y : ℕ) : weight (compl24 y) + weight y = 24 := by
  rw [weight_eq_sum, weight_eq_sum, ← Finset.sum_add_distrib]
  rw [Finset.sum_congr rfl (g := fun _ => 1)]
  · simp
  intro i hi
  rw [Finset.mem_range] at hi
  rw [compl24, Nat.testBit_xor, Nat.testBit_two_pow_sub_one]
  cases y.testBit i <;> simp [hi]

/-- Complementing commutes with every symmetry, so it carries orbits to orbits. -/
theorem reach_compl {x y : ℕ} (h : Reach gensM x y) : Reach gensM (compl24 x) (compl24 y) := by
  induction h with
  | refl => exact Reach.refl
  | step g hg _ ih => rw [← pmask_compl]; exact Reach.step g hg ih

/-! ## The complete census -/

/-- The 49 representatives: the roots for `0 … 12` cells and the complements of the roots for
`0 … 11` cells. -/
def reps49 : List ℕ :=
  (List.range 13).flatMap censusRoots ++ (List.range 12).flatMap (fun k => (censusRoots k).map compl24)

/-- The invariant signature separating all 49 representatives. -/
def flags (y : ℕ) : List Bool :=
  [octadMeet 6 y, octadMeet 7 y, octadMeet 8 y, dodecadMeet 11 y, dodecadMeet 12 y]

def sig (y : ℕ) : ℕ × List Bool × List Bool := (weight y, flags y, flags (compl24 y))

theorem flags_pmask {g : Equiv.Perm (Fin 24)} (hg : g ∈ gensM) {y : ℕ} (hy : y < 2 ^ 24) :
    flags (pmask g y) = flags y := by
  simp only [flags, octadMeet, dodecadMeet, invariant_hasMeet _ _ g hg y hy]

theorem sig_pmask {g : Equiv.Perm (Fin 24)} (hg : g ∈ gensM) {y : ℕ} (hy : y < 2 ^ 24) :
    sig (pmask g y) = sig y := by
  rw [sig, sig, weight_pmask, flags_pmask hg hy, ← pmask_compl, flags_pmask hg (compl24_lt hy)]

theorem reach_sig {x y : ℕ} (hx : x < 2 ^ 24) (h : Reach gensM x y) : sig y = sig x := by
  induction h with
  | refl => rfl
  | step g hg hr ih => rw [sig_pmask hg (reach_lt hx hr), ih]

theorem reps49_facts : reps49.length = 49 ∧ reps49.Nodup ∧ (reps49.map sig).Nodup ∧
    ∀ r ∈ reps49, r < 2 ^ 24 := by native_decide

theorem roots_weight : ∀ k < 13, ∀ r ∈ censusRoots k, weight r = k := by native_decide

theorem census_all : ∀ k ≤ 12, censusCheck k (censusRoots k) (censusSizes k) = true := by
  intro k hk
  interval_cases k
  exacts [census0, census1, census2, census3, census4, census5, census6, census7, census8,
    census9, census10, census11, census12]

theorem reach_root {y : ℕ} (hy : y < 2 ^ 24) (hk : weight y ≤ 12) :
    ∃ r ∈ (List.range 13).flatMap censusRoots, Reach gensM r y := by
  obtain ⟨j, hj, hr⟩ := censusCheck_sound (census_all _ hk) hy rfl
  refine ⟨_, ?_, hr⟩
  rw [List.mem_flatMap]
  exact ⟨weight y, List.mem_range.2 (by omega), by
    rw [List.getD_eq_getElem _ _ hj]; exact List.getElem_mem hj⟩

/-- **The complete census: 49 orbits.**  Every 24-cell pattern is reached from one of the 49
representatives, and from only one. -/
theorem census_49 :
    reps49.length = 49 ∧
    (∀ y < 2 ^ 24, ∃ r ∈ reps49, Reach gensM r y) ∧
    (∀ r ∈ reps49, ∀ r' ∈ reps49, ∀ y, Reach gensM r y → Reach gensM r' y → r = r') := by
  obtain ⟨hlen, _, hsig, hlt⟩ := reps49_facts
  refine ⟨hlen, fun y hy => ?_, fun r hr r' hr' y h h' => ?_⟩
  · by_cases hk : weight y ≤ 12
    · obtain ⟨r, hr, hreach⟩ := reach_root hy hk
      exact ⟨r, List.mem_append_left _ hr, hreach⟩
    · have hw := weight_compl24 y
      obtain ⟨r, hr, hreach⟩ := reach_root (compl24_lt hy) (by omega)
      refine ⟨compl24 r, List.mem_append_right _ ?_, ?_⟩
      · obtain ⟨k, hk', hrk⟩ := List.mem_flatMap.1 hr
        have hwr : weight r = k := roots_weight k (List.mem_range.1 hk') r hrk
        have hk12 : k < 12 := by have := reach_weight' hreach; omega
        exact List.mem_flatMap.2 ⟨k, List.mem_range.2 hk12, List.mem_map.2 ⟨r, hrk, rfl⟩⟩
      · have := reach_compl hreach
        rwa [compl24_compl24] at this
  · have e1 := reach_sig (hlt r hr) h
    have e2 := reach_sig (hlt r' hr') h'
    exact List.inj_on_of_nodup_map hsig hr hr' (by rw [← e1, ← e2])

