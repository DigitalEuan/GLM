import RequestProject.GLM.Rule30.PowerSeriesLadderData

/-!
# Round 44: certificates that settle two "thinks true" entries of the owner's Wheel

The owner's `glm_wheel.json` (generated by `glm_wheel.py` from engine v16) lists, on its
"thinks is true" ring, the belief

  **H19**: `|2·L(n) − n| ≤ 10` for all `n`,

where `L(n)` is the linear complexity of the first `n` centre-column bits (Berlekamp–Massey). The
engine "narrowed" the constant on `n ≤ 3000`. The study ledger (row C160) also records "linear
complexity within 6 of `n/2` for `n ≤ 20000`".

It also lists **H16**: the centre column has no eventual period `p ≤ 64` with preperiod
`≤ 10000`. That one is true, and `wheel_H16_true` certifies it with one witness per period.

H19 and C160 are false:

* `lcProfile_centerCol_11101` : `5556 ≤ L(11101)`, so `2·L(11101) − 11101 ≥ 11`;
  `wheel_H19_false` : the Wheel belief is refuted.
* `lcProfile_centerCol_19521` : `9767 ≤ L(19521)`, so `L(19521) − 19521/2 ≥ 6.5`;
  `ledger_C160_overstated` : "within 6 of `n/2`" fails on `n ≤ 20000`.

(Berlekamp–Massey gives `L(11101) = 5556` and `L(19521) = 9767` exactly; only the lower bounds are
certified here, and they are what refutes the two statements.)

**How the certificate works** (`le_lcProfile_of_farkas`, FORMAL). `L(m) ≤ K` means some
recurrence of order `K` predicts `a(n)` for `K ≤ n < m`: a linear system over `GF(2)` in the `K`
coefficients. A Farkas vector `y` (a set of equations whose sum has all coefficients `0` and
right-hand side `1`) shows the system has no solution. The vectors were found by an unverified
elimination; only the check is trusted. The check itself is `native_decide` (CERT).
-/

namespace GLM.HypothesisEngine.WheelChecks

open GLM.Rule30 Finset

/-- **Farkas certificate for linear complexity.** If the rows `R k` (`k < m - K`) hold the bits
`a(K + k − 1 − i)`, `i < K`, the `y`-combination of the rows is zero on the first `K` bits, and the
`y`-combination of the right-hand sides `a(K + k)` is one, then no recurrence of order `K`
generates `a(0), …, a(m−1)`, so `K + 1 ≤ L(m)`. -/
theorem le_lcProfile_of_farkas {a : ℕ → Bool} {K m : ℕ} (y : ℕ) (R : ℕ → ℕ)
    (hR : ∀ k < m - K, ∀ i < K, (R k).testBit i = a (K + k - 1 - i))
    (h0 : ∀ i < K, (xorCombo y R (m - K)).testBit i = false)
    (h1 : ∑ k ∈ range (m - K), b2 (y.testBit k) * b2 (a (K + k)) = 1) :
    K + 1 ≤ lcProfile a m := by
  by_contra hlt
  push_neg at hlt
  obtain ⟨c, hc⟩ := lcProfile_spec a m
  have hfit := fits_pad hc (show lcProfile a m ≤ K by omega)
  set c' : ℕ → Bool := fun i => decide (i < lcProfile a m) && c i
  have heq : ∀ k < m - K, b2 (a (K + k)) =
      ∑ i ∈ range K, b2 (c' i) * b2 ((R k).testBit i) := by
    intro k hk
    rw [hfit (K + k) (by omega) (by omega)]
    unfold recVal
    refine Finset.sum_congr rfl fun i hi => ?_
    rw [Finset.mem_range] at hi
    rw [hR k hk i hi, b2_and, show K + k - 1 - i = K + k - 1 - i from rfl]
  have : (1 : ZMod 2) = 0 := by
    rw [← h1]
    calc ∑ k ∈ range (m - K), b2 (y.testBit k) * b2 (a (K + k))
        = ∑ k ∈ range (m - K), b2 (y.testBit k) *
            ∑ i ∈ range K, b2 (c' i) * b2 ((R k).testBit i) :=
          Finset.sum_congr rfl fun k hk => by rw [heq k (Finset.mem_range.1 hk)]
      _ = ∑ i ∈ range K, b2 (c' i) *
            ∑ k ∈ range (m - K), b2 (y.testBit k) * b2 ((R k).testBit i) := by
          simp only [Finset.mul_sum]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun k _ => by ring
      _ = ∑ i ∈ range K, b2 (c' i) * b2 ((xorCombo y R (m - K)).testBit i) := by
          refine Finset.sum_congr rfl fun i _ => by rw [b2_testBit_xorCombo]
      _ = 0 := Finset.sum_eq_zero fun i hi => by
          rw [h0 i (Finset.mem_range.1 hi)]; simp [b2]
  exact absurd this (by decide)

/-- The first `m` centre bits in reverse order, packed: bit `j` is `a(m − 1 − j)`. -/
def revPack (m : ℕ) : ℕ := packBits (list20000.take m).reverse

theorem list20000_length : list20000.length = 20000 := by
  rw [list20000_eq]; simp

theorem testBit_revPack {m j : ℕ} (hm : m ≤ 20000) (hj : j < m) :
    (revPack m).testBit j = centerCol (m - 1 - j) := by
  have hlen : (list20000.take m).length = m := by simp [list20000_length, hm]
  rw [revPack, testBit_packBits, List.getD_eq_getElem _ _ (by simp [hlen, hj]),
    List.getElem_reverse, List.getElem_take, centerCol_eq_getD _ (by omega),
    List.getD_eq_getElem _ _ (by rw [list20000_length]; omega)]
  congr 1
  simp [hlen]

/-- Row `k` of the system: bits `a(K + k − 1 − i)`, `i < K`. -/
def farkasRow (m K : ℕ) (Q : ℕ) (k : ℕ) : ℕ := (Q >>> (m - K - k)) % 2 ^ K

/-- Right-hand side `k`: the bit `a(K + k)` as `0`/`1`. -/
def farkasRhs (K : ℕ) (k : ℕ) : ℕ := if P20000.testBit (K + k) then 1 else 0

/-- The finite check. -/
def farkasCheck (m K y : ℕ) : Bool :=
  let Q := revPack m
  xorCombo y (farkasRow m K Q) (m - K) % 2 ^ K == 0 &&
    (xorCombo y (farkasRhs K) (m - K)).testBit 0

theorem le_lcProfile_of_check {m K y : ℕ} (hm : m ≤ 20000) (hKm : K ≤ m)
    (hc : farkasCheck m K y = true) : K + 1 ≤ lcProfile centerCol m := by
  simp only [farkasCheck, Bool.and_eq_true, beq_iff_eq] at hc
  obtain ⟨hz, hone⟩ := hc
  refine le_lcProfile_of_farkas y (farkasRow m K (revPack m)) ?_ ?_ ?_
  · intro k hk i hi
    rw [farkasRow, Nat.testBit_mod_two_pow, Nat.testBit_shiftRight, decide_eq_true hi,
      Bool.true_and, testBit_revPack hm (by omega)]
    congr 1; omega
  · intro i hi
    have := congrArg (fun x => x.testBit i) hz
    simpa [Nat.testBit_mod_two_pow, hi] using this
  · have := b2_testBit_xorCombo y (farkasRhs K) (m - K) 0
    rw [hone] at this
    rw [show b2 true = 1 from rfl] at this
    rw [this]
    refine Finset.sum_congr rfl fun k hk => ?_
    rw [Finset.mem_range] at hk
    congr 1
    unfold farkasRhs
    rw [testBit_P20000 _ (by omega)]
    cases centerCol (K + k) <;> simp [b2]

