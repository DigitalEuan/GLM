def y19521 : ℕ := 

theorem check_11101 : farkasCheck 11101 5555 y11101 = true := by native_decide

theorem check_19521 : farkasCheck 19521 9766 y19521 = true := by native_decide

/-- **`L(11101) ≥ 5556`.** -/
theorem lcProfile_centerCol_11101 : 5556 ≤ lcProfile centerCol 11101 :=
  le_lcProfile_of_check (by norm_num) (by norm_num) check_11101

/-- **`L(19521) ≥ 9767`.** -/
theorem lcProfile_centerCol_19521 : 9767 ≤ lcProfile centerCol 19521 :=
  le_lcProfile_of_check (by norm_num) (by norm_num) check_19521

/-- **The Wheel's belief H19 is false**: `|2·L(n) − n| ≤ 10` fails at `n = 11101`. -/
theorem wheel_H19_false :
    ¬ ∀ n : ℕ, |2 * (lcProfile centerCol n : ℤ) - n| ≤ 10 := by
  intro h
  have := h 11101
  have hL := lcProfile_centerCol_11101
  rw [abs_le] at this
  omega

/-- **Ledger row C160 is overstated**: the linear complexity is not within 6 of `n/2` for all
`n ≤ 20000`; at `n = 19521` it is at least `6.5` above. -/
theorem ledger_C160_overstated :
    ∃ n ≤ 20000, 13 ≤ 2 * (lcProfile centerCol n : ℤ) - n :=
  ⟨19521, by norm_num, by have := lcProfile_centerCol_19521; omega⟩

/-! ## H16: no short eventual period starting by time 10000 -/

theorem h16_check : ∀ p < 65, 1 ≤ p →
    ∃ n < 19900, 10000 ≤ n ∧ arr20000.getD (n + p) false ≠ arr20000.getD n false := by
  native_decide

/-- **The Wheel's H16 is true** (finite witnesses): the centre column has no eventual period
`p ≤ 64` with preperiod `τ ≤ 10000`. -/
theorem wheel_H16_true : ∀ τ ≤ 10000, ∀ p, 1 ≤ p → p ≤ 64 →
    ¬ ∀ n ≥ τ, centerCol (n + p) = centerCol n := by
  intro τ hτ p hp1 hp h
  obtain ⟨n, hn, hn', hne⟩ := h16_check p (by omega) hp1
  rw [arr20000_getD _ (by omega), arr20000_getD _ (by omega)] at hne
  exact hne (h n (by omega))

end GLM.HypothesisEngine.WheelChecks
